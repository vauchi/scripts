#!/bin/bash
# SPDX-FileCopyrightText: 2026 Mattia Egloff <mattia.egloff@pm.me>
#
# SPDX-License-Identifier: GPL-3.0-or-later

# Commit message format validation hook.
# Enforces: {type}: {description}
# Valid types: feat, fix, refactor, tidy, docs, test, chore, wip
#
# Multi-line messages must have a blank line after the subject.
# Merge commits and fixup/squash commits are allowed through.

set -euo pipefail

MSG_FILE="$1"
SUBJECT=$(head -n 1 "$MSG_FILE")

# Allow merge commits
if echo "$SUBJECT" | grep -qE "^Merge "; then
    exit 0
fi

# Allow fixup/squash commits (git rebase)
if echo "$SUBJECT" | grep -qE "^(fixup|squash)! "; then
    exit 0
fi

# Allow revert commits
if echo "$SUBJECT" | grep -qE "^Revert \""; then
    exit 0
fi

# Validate format: {type}: {description}
VALID_TYPES="feat|fix|refactor|tidy|docs|test|chore|wip|diag"
if ! echo "$SUBJECT" | grep -qE "^($VALID_TYPES): .+"; then
    echo ""
    echo "  VGT08: invalid commit message format — fix: prefix with '{type}: '. [_private/docs/lint-errors/vgt08-commit-format.md]"
    echo ""
    echo "  Expected: {type}: {description}"
    echo "  Got:      $SUBJECT"
    echo ""
    echo "  Valid types: feat, fix, refactor, tidy, docs, test, chore, wip, diag"
    echo ""
    echo "  Examples:"
    echo "    feat: implement BLE transport"
    echo "    fix: correct QR expiry check"
    echo "    tidy: extract helper for key derivation"
    echo "    test: add proptest for field validation"
    echo ""
    exit 1
fi

# VGT11: a `fix:` that touches code carries evidence — a test file in the
# same commit or an `Evidence:` trailer naming what was observed. This is
# the deterministic tier of CC-27 for the one defect class the
# intervention ledger and reasoning-error log both rank first: a fix
# asserted without being verified. Docs-only fixes are exempt.
# The trailer must name the after-state: a trailer citing only the red job
# passed the old length check on fixes that turned out wrong (macos 067c6d8).
# Page: _private/docs/lint-errors/vgt11-fix-evidence.md
if echo "$SUBJECT" | grep -qE "^fix: "; then
    STAGED=$(git diff --cached --name-only 2>/dev/null || true)
    CODE_PATHS=$(echo "$STAGED" | grep -vE '(\.(md|txt|svg|png|jpg|jpeg|webp|gif)$|^LICENSES/|^$)' || true)
    TEST_PATHS=$(echo "$STAGED" | grep -E '(^|/)(tests?|__tests__|[A-Za-z]+Tests?)/|/src/(test|androidTest)/|\.test\.[a-z]+$|\.spec\.[jt]s$|_test\.[a-z]+$|(^|/)test_[^/]+\.py$' || true)
    # The trailer runs to the first blank line or the next `Key: ` trailer;
    # a continuation line beginning `after:` stays part of it.
    EVIDENCE=$(awk '
        /^#/ { next }
        /^Evidence: / { inblock = 1; print; next }
        inblock && (/^[[:space:]]*$/ || (/^[A-Z][A-Za-z-]*: / && tolower(substr($0, 1, 6)) != "after:")) { inblock = 0 }
        inblock { print }
    ' "$MSG_FILE" | tr '\n' ' ')
    AFTER_VALUE=$(printf '%s\n' "$EVIDENCE" | awk '
        { i = index(tolower($0), "after:"); if (i) { v = substr($0, i + 6); sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v); print v } }
    ')
    PREDICTION='(^|[^a-z])(should|will|would|expected|expect|hopefully|pending|not yet|tbd|once ci)([^a-z]|$)'
    # A quoted tool message is what was observed, whatever words it holds
    # (YAML says "did not find expected ','", #783). Single quotes count only
    # at word edges, so the text between two apostrophes is still read.
    AFTER_UNQUOTED=$(printf '%s' "$AFTER_VALUE" |
        sed -E "s/\"[^\"]*\"//g; s/\`[^\`]*\`//g; s/(^|[^[:alnum:]])'[^']*'([^[:alnum:]]|\$)/\1\2/g")
    EVIDENCE_OK=""
    if [ ${#EVIDENCE} -ge 30 ] && [ ${#AFTER_VALUE} -ge 10 ] \
        && ! printf '%s' "$AFTER_UNQUOTED" | grep -qiE "$PREDICTION"; then
        EVIDENCE_OK=1
    fi
    if [ -n "$CODE_PATHS" ] && [ -z "$TEST_PATHS" ] && [ -z "$EVIDENCE_OK" ]; then
        echo ""
        echo "  VGT11: fix commit touches code without an observed after-state — fix: stage the test that observed the failure, or write 'Evidence: before: <what failed>; after: <what you observed with the fix>'. The after: part is an observation, not a prediction. If you have not seen it yet, this is a hypothesis: commit it as 'diag: <change> to test <theory>'. [_private/docs/lint-errors/vgt11-fix-evidence.md]"
        echo ""
        echo "  Code paths staged:"
        echo "$CODE_PATHS" | sed 's/^/    /'
        if [ -n "$EVIDENCE" ]; then
            echo ""
            echo "  Evidence found, but no observed after: in it:"
            echo "    $EVIDENCE"
        fi
        echo ""
        echo "  Example trailer:"
        echo "    Evidence: before: 502 on \`just deploy-check\`; after: 200 on the same command"
        echo ""
        exit 1
    fi
fi

# VGT12: a behaviour change on a protocol path says what it means for the
# spec (vauchi/private#874). The name checks catch a renamed function and
# the claim annotations a deleted test; neither catches a function that
# keeps its name and no longer does what the chapter says. Only the
# person changing the behaviour knows that, so the commit says it:
# `Spec: unchanged`, or the claims and sections it moves.
# Page: _private/docs/lint-errors/vgt12-spec-trailer.md
if echo "$SUBJECT" | grep -qE "^(feat|fix|refactor): "; then
    STAGED_FOR_SPEC=$(git diff --cached --name-only 2>/dev/null || true)
    REPO_NAME=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")
    case "$REPO_NAME" in
        relay|ohttp-relay) SPEC_PATHS='^src/' ;;
        *) SPEC_PATHS='^(vauchi-core/src/(crypto|exchange|network|backup|recovery|sync)/|vauchi-core/verification/|vauchi-protocol/src/)' ;;
    esac
    SPEC_TOUCHED=$(echo "$STAGED_FOR_SPEC" | grep -E "$SPEC_PATHS" | grep -vE '\.md$' || true)
    SPEC_TRAILER=$(grep -vE '^#' "$MSG_FILE" | grep -E '^Spec: [^[:space:]]' | head -1 || true)
    if [ -n "$SPEC_TOUCHED" ] && [ -z "$SPEC_TRAILER" ]; then
        echo ""
        echo "  VGT12: $(echo "$SUBJECT" | cut -d: -f1) commit touches a protocol path without a Spec: trailer — fix: end the message with 'Spec: unchanged' if the spec's claims and chapters still describe the code, or 'Spec: <claim ids, chapter sections, spec!N>' naming what this moves. [_private/docs/lint-errors/vgt12-spec-trailer.md]"
        echo ""
        echo "  Protocol paths staged:"
        echo "$SPEC_TOUCHED" | sed 's/^/    /'
        echo ""
        echo "  Example trailers:"
        echo "    Spec: unchanged"
        echo "    Spec: S4, relay B5, update-and-sync C1 (spec!9)"
        echo ""
        exit 1
    fi
fi

# VGT13: a behaviour change to how exchange codes are read or drawn says
# how it ran on the rig at both ends of the 7–14 cm target. Generated
# test codes do not stand in for a phone camera: core 57e1e7770 passed
# them, was run at 7–10 cm only, and Hover failed 17 of 17 at 13.5 cm
# (vauchi/private#450, post-mortem 2026-10-30).
# Page: _private/docs/lint-errors/vgt13-rig-trailer.md
if echo "$SUBJECT" | grep -qE "^(feat|fix|refactor): "; then
    STAGED_FOR_RIG=$(git diff --cached --name-only 2>/dev/null || true)
    REPO_NAME=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")
    case "$REPO_NAME" in
        core) RIG_PATHS='^vauchi-core/src/(qr_decode\.rs|qr/|exchange/multistage/(qr_codec|chunker|link_trainer|training_header|session|base45)\.rs)' ;;
        android) RIG_PATHS='^app/src/main/kotlin/app/vauchi/ui/(components/QrCodeAnalyzer|presentation/QrPrimitives)\.kt$' ;;
        ios) RIG_PATHS='^Vauchi/CoreUI/MultipartCameraPreview\.swift$' ;;
        *) RIG_PATHS='' ;;
    esac
    RIG_TOUCHED=""
    [ -n "$RIG_PATHS" ] && RIG_TOUCHED=$(echo "$STAGED_FOR_RIG" | grep -E "$RIG_PATHS" || true)
    RIG_TRAILER=$(grep -vE '^#' "$MSG_FILE" | grep -E '^Rig: ' | head -1 | sed 's/^Rig: *//' || true)
    RIG_OK=0
    if echo "$RIG_TRAILER" | grep -qE '^n/a +— +[^[:space:]]'; then
        RIG_OK=1
    elif echo "$RIG_TRAILER" | grep -qE '(^|[^0-9])7 ?cm' && echo "$RIG_TRAILER" | grep -qE '(^|[^0-9])14 ?cm'; then
        RIG_OK=1
    fi
    if [ -n "$RIG_TOUCHED" ] && [ "$RIG_OK" = 0 ]; then
        echo ""
        echo "  VGT13: $(echo "$SUBJECT" | cut -d: -f1) commit changes how exchange codes are read or drawn without a Rig: trailer naming 7 cm and 14 cm — fix: run the rig at both ends (vauchi-gui-test.sh hover-bench) and end the message with 'Rig: 7 cm <n>/<n>, 14 cm <n>/<n> (<date>)', or 'Rig: n/a — <why no frame or timing changes>'. [_private/docs/lint-errors/vgt13-rig-trailer.md]"
        echo ""
        echo "  Paths staged:"
        echo "$RIG_TOUCHED" | sed 's/^/    /'
        echo ""
        exit 1
    fi
fi

# VGT15: public text says which shipped work it describes. Public pages
# described designs as shipped behaviour in 58 places and called shipped
# features planned in others; nothing asked, at the moment the text
# changed, whether the code was there (vauchi/private#1229, #1237).
# The rule lives in check-shipped-in.sh, shared with the CI re-check.
# Page: _private/docs/lint-errors/vgt15-shipped-in-trailer.md
SHIPPED_IN_CHECK="$(cd "$(dirname "$0")/../scripts" 2>/dev/null && pwd)/check-shipped-in.sh"
if [ ! -x "$SHIPPED_IN_CHECK" ]; then
    echo "  VGT15: $SHIPPED_IN_CHECK is missing — the check cannot run; restore it from vauchi/scripts." >&2
    exit 1
fi
"$SHIPPED_IN_CHECK" --staged "$MSG_FILE" || exit 1

# Check subject line length (soft warning at 72 chars)
SUBJECT_LEN=${#SUBJECT}
if [ "$SUBJECT_LEN" -gt 72 ]; then
    echo "WARNING: Subject line is $SUBJECT_LEN chars (recommended max: 72)"
fi

# If multi-line, check blank line after subject
LINE_COUNT=$(wc -l < "$MSG_FILE")
if [ "$LINE_COUNT" -gt 1 ]; then
    SECOND_LINE=$(sed -n '2p' "$MSG_FILE")
    if [ -n "$SECOND_LINE" ]; then
        echo "WARNING: No blank line after subject (line 2 is not empty)"
    fi
fi
