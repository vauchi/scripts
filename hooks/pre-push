#!/bin/bash
# Pre-push hook: Runs format, lint, and test checks before every push.
# Matches CI pipeline checks exactly.
# Skip all checks: git push --no-verify
# Skip tests only:  SKIP_TESTS=1 git push
#
# Fast path: If `just check` was run on the current HEAD, checks are skipped
# (TDD stamp mechanism — see scripts/scripts/stamp.sh).
#
# Supported repo types:
# - Rust (core, cli, tui, relay, desktop, e2e): cargo fmt, clippy, test
# - Swift/iOS: swiftformat, swiftlint
# - Android/Kotlin: compileDebugKotlin, lint
#
# Install with: just install-hooks

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_DIR="$(basename "$REPO_ROOT")"
BRANCH="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
HOOK_START=$SECONDS
_STAMP_SKIP=0

echo "=== Pre-push checks ($REPO_DIR) ==="

# ─── Pushed-ref specs (stdin is read exactly once) ──────────────────
# git feeds one "<local ref> <local sha> <remote ref> <remote sha>"
# line per pushed ref. A deletion carries the zero OID as local sha.

PUSH_SPECS="$(cat)"

# ─── Delete-only fast path ───────────────────────────────────────────
# A push that only deletes remote refs carries no content — running
# fmt/lint/tests against the unrelated local HEAD validates nothing,
# and a red working tree would block deleting an unrelated branch.
# Deleting remote main is blocked outright.

DELETE_ONLY=true
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "$local_ref" ]] && continue
    if [[ "$local_sha" =~ ^0+$ ]]; then
        if [[ "$remote_ref" == "refs/heads/main" ]]; then
            echo ""
            echo "BLOCKED: refusing to delete remote main."
            exit 1
        fi
    else
        DELETE_ONLY=false
    fi
done <<< "$PUSH_SPECS"

if [[ -n "$PUSH_SPECS" && "$DELETE_ONLY" == "true" ]]; then
    echo "  Delete-only push — no content to check, skipping."
    exit 0
fi

# ─── WIP commit guard ────────────────────────────────────────────────
# Block pushing if HEAD is a WIP checkpoint commit (created by `just git wip`).
# WIP commits are temporary saves — undo with `just git wip-undo` before pushing.

HEAD_MSG="$(git -C "$REPO_ROOT" log -1 --format=%s 2>/dev/null || true)"
if [[ "$HEAD_MSG" == wip:* ]]; then
    echo ""
    echo "BLOCKED: HEAD commit is a WIP checkpoint:"
    echo "  $HEAD_MSG"
    echo ""
    echo "WIP commits must not be pushed. Undo first:"
    echo "  just git wip-undo"
    echo ""
    echo "Or squash the WIP commit into the previous one:"
    echo "  git reset --soft HEAD~1 && git commit --amend"
    exit 1
fi

# ─── Main branch push guard ───────────────────────────────────────
# Block direct pushes to main. GitLab Owner role bypasses server-side
# branch protection — this hook enforces MR-only workflow locally.
# Skip: --no-verify (escape hatch), or --tags (tag-only push).

if [[ "$BRANCH" == "main" ]]; then
    # Allow tag-only pushes (no branch ref pushed)
    TAG_ONLY=true
    while read -r local_ref local_sha remote_ref remote_sha; do
        [[ -z "$local_ref" ]] && continue
        if [[ "$remote_ref" != refs/tags/* ]]; then
            TAG_ONLY=false
            break
        fi
    done <<< "$PUSH_SPECS"
    if [[ "$TAG_ONLY" == "false" ]]; then
        echo ""
        echo "BLOCKED: Direct push to main. Use a branch + MR:"
        echo "  1. git checkout -b feature/<topic>"
        echo "  2. ... make changes ..."
        echo "  3. git push -u origin feature/<topic>"
        echo "  4. just gitlab mr-create"
        echo ""
        echo "Escape hatch: git push --no-verify (not recommended)"
        exit 1
    fi
fi

# ─── Stale base guard ──────────────────────────────────────────────
# If pushing a feature branch that is not rebased on origin/main, rebase
# locally then block this push (git computes refs-to-push BEFORE the hook
# runs, so the rebase can't change what gets sent — the user re-pushes).
# Extracted to a tested helper; the pushed-ref specs are piped in so the
# guard can tell a branch push from a tag-only push.
# See tests/stale-base-guard.test.sh.
"$HOOK_DIR/lib/stale-base-guard.sh" "$REPO_ROOT" <<< "$PUSH_SPECS" || exit 1

# ─── Git dependency branch ref guard ──────────────────────────────────
# Checks Cargo.toml for non-main branch refs in git dependencies.
# Dead branch refs (upstream merged+deleted) BLOCK the push.
# Live non-main refs get a WARNING (active cross-repo development).

if [[ -f "$REPO_ROOT/Cargo.toml" ]]; then
    BAD_REFS=$(grep -E 'git\s*=.*branch\s*=' "$REPO_ROOT/Cargo.toml" \
        | grep -v 'branch = "main"' || true)
    if [[ -n "$BAD_REFS" ]]; then
        _BRANCH_BLOCK=0
        _BRANCH_WARN=0
        while IFS= read -r line; do
            _dep_url=$(echo "$line" | sed -n 's/.*git = "\([^"]*\)".*/\1/p')
            _dep_branch=$(echo "$line" | sed -n 's/.*branch = "\([^"]*\)".*/\1/p')
            [[ -z "$_dep_url" || -z "$_dep_branch" ]] && continue
            # Check if branch exists on remote (5s timeout, portable)
            _ls_out=$(git ls-remote "$_dep_url" "refs/heads/$_dep_branch" 2>/dev/null &
                _pid=$!; (sleep 5 && kill "$_pid" 2>/dev/null) &
                wait "$_pid" 2>/dev/null) || true
            if echo "$_ls_out" | grep -q .; then
                _BRANCH_WARN=1
                echo "  WARNING: Cargo.toml points to non-main branch '$_dep_branch'"
                echo "    ($_dep_url)"
            else
                _BRANCH_BLOCK=1
                echo "  BLOCKED: Branch '$_dep_branch' no longer exists on remote"
                echo "    ($_dep_url)"
            fi
        done <<< "$BAD_REFS"
        if [[ $_BRANCH_BLOCK -eq 1 ]]; then
            echo ""
            echo "  Dead branch ref(s) in Cargo.toml. Fix:"
            echo "    just fix-branch-refs   # or manually:"
            echo "    sed -i.bak 's/branch = \"[^\"]*\"/branch = \"main\"/g' Cargo.toml && rm Cargo.toml.bak"
            echo "    cargo update && git add Cargo.toml Cargo.lock"
            exit 1
        fi
        if [[ $_BRANCH_WARN -eq 1 ]]; then
            echo "  (Non-main refs are OK during development — must be 'main' before merging)"
            echo ""
        fi
    fi
fi

# ─── Cargo.lock git-source guard ──────────────────────────────────────
# Local dev uses .cargo/config.toml path overrides that resolve git
# dependencies to an in-workspace path. Running `cargo update` (or any
# cargo command that re-resolves the lockfile) while those overrides
# are in effect strips the `source = "git+..."` line from the matching
# [[package]] entries in Cargo.lock. The lockfile still parses, local
# builds still succeed (path overrides cover it), but CI clones the
# branch fresh, sees no source, and silently falls back to an older
# cached SHA — producing spurious failures against stale upstream code.
#
# For every `<name> = { git = "https://..." }` entry in Cargo.toml,
# require Cargo.lock's matching [[package]] block to carry a
# `source = "git+<same-url>..."` line. If any are missing, block with
# the fix recipe.

if [[ -f "$REPO_ROOT/Cargo.toml" && -f "$REPO_ROOT/Cargo.lock" ]]; then
    _GIT_DEPS=$(awk '
        /^\[/ { in_dep = /^\[(dependencies|dev-dependencies|build-dependencies|workspace\.dependencies)\]/ }
        in_dep && /^[a-zA-Z0-9_-]+ *=.*[^a-zA-Z_]git *=/ {
            name = $1
            match($0, /git *= *"([^"]+)"/, u)
            if (u[1] != "") print name "\t" u[1]
        }
    ' "$REPO_ROOT/Cargo.toml" 2>/dev/null | sort -u || true)

    if [[ -n "$_GIT_DEPS" ]]; then
        _LOCK_MISSING=""
        while IFS=$'\t' read -r _name _url; do
            [[ -z "$_name" ]] && continue
            _pkg_block=$(awk -v n="$_name" '
                $0 == "[[package]]" { block = ""; in_block = 1 }
                in_block { block = block "\n" $0 }
                in_block && $0 ~ "^name = \"" n "\"$" { found = 1 }
                in_block && NF == 0 {
                    if (found) { print block; exit }
                    in_block = 0; found = 0
                }
            ' "$REPO_ROOT/Cargo.lock" 2>/dev/null)
            if [[ -n "$_pkg_block" ]] && ! echo "$_pkg_block" | grep -q "^source = \"git+"; then
                _LOCK_MISSING="${_LOCK_MISSING}  ${_name} (Cargo.toml: ${_url})\n"
            fi
        done <<< "$_GIT_DEPS"

        if [[ -n "$_LOCK_MISSING" ]]; then
            echo ""
            echo "BLOCKED: Cargo.lock is missing git source lines for dependencies:"
            printf '%b' "$_LOCK_MISSING"
            echo ""
            echo "This happens when cargo re-resolves the lockfile while"
            echo "local path overrides in .cargo/config.toml are active."
            echo "CI does not have those overrides — the push would fail."
            echo ""
            echo "  Fix:"
            echo "    mv .cargo/config.toml .cargo/config.toml.bak"
            echo "    git checkout origin/main -- Cargo.lock"
            echo "    cargo update -p <dep-name>  # repeat per affected dep"
            echo "    mv .cargo/config.toml.bak .cargo/config.toml"
            echo "    git add Cargo.lock && git commit --amend --no-edit"
            echo ""
            echo "  Or use the recipe:    just fix-lockfile-sources"
            exit 1
        fi
    fi
fi

# ─── Plan-Task trailer advisory ──────────────────────────────────────
if [[ -n "$BRANCH" && "$BRANCH" == feature/* ]]; then
    COMMITS_WITHOUT_TRAILER=$(git -C "$REPO_ROOT" log origin/main..HEAD \
        --format='%h %s' \
        --invert-grep --grep='Plan-Task:' 2>/dev/null || true)
    if [[ -n "$COMMITS_WITHOUT_TRAILER" ]]; then
        COUNT=$(echo "$COMMITS_WITHOUT_TRAILER" | wc -l | tr -d ' ')
        echo "⚠ ${COUNT} commit(s) on ${BRANCH} have no Plan-Task: trailer:"
        echo "$COMMITS_WITHOUT_TRAILER" | head -5 | sed 's/^/  /'
        if [[ $COUNT -gt 5 ]]; then
            echo "  ... and $((COUNT - 5)) more"
        fi
        echo "  (This is informational — push continues)"
        echo ""
    fi
fi

# ─── Security-pattern scan ──────────────────────────────────────────
# Scans diff for security-sensitive patterns that indicate regressions.
# Patterns are repo-scoped. Blocking for definite violations, advisory
# for high-false-positive patterns.
# Override a finding: add "// security-scan-ok: <reason>" on that line.
# See: _private/docs/designs/2026-03-27-self-healing-reasoning-errors-design.md

_security_scan() {
    local EXIT_CODE=0
    local DIFF
    DIFF=$(git -C "$REPO_ROOT" diff origin/main..HEAD -- '*.rs' '*.kt' '*.swift' '*.java' 2>/dev/null || true)
    [[ -z "$DIFF" ]] && return 0

    # Only check added/modified lines (lines starting with +, not +++ header)
    local ADDED_LINES
    ADDED_LINES=$(echo "$DIFF" | grep '^+[^+]' | grep -v 'security-scan-ok' || true)
    [[ -z "$ADDED_LINES" ]] && return 0

    # ── Blocking patterns (repo-scoped) ──

    if [[ "$REPO_DIR" == "android" ]]; then
        # FLAG_SECURE commented out or removed outside debug guard
        if echo "$ADDED_LINES" | grep -i 'FLAG_SECURE' | grep -qiE '//.*FLAG_SECURE|/\*.*FLAG_SECURE'; then
            echo "  SECURITY: FLAG_SECURE appears commented out"
            echo "    FLAG_SECURE must be active in release builds."
            echo "    Gate on BuildConfig.DEBUG if disabling for dev."
            EXIT_CODE=1
        fi

        # Debug intents without BuildConfig.DEBUG guard
        if echo "$ADDED_LINES" | grep -q '\-\-es.*navigate'; then
            if ! echo "$ADDED_LINES" | grep -q 'BuildConfig.DEBUG'; then
                echo "  SECURITY: Debug navigation intent may not be guarded by BuildConfig.DEBUG"
                echo "    External apps could drive in-app navigation in release."
                EXIT_CODE=1
            fi
        fi
    fi

    # ── Advisory patterns (all Rust/mobile repos) ──

    # QR data near logging calls (high false-positive risk — advisory only)
    if echo "$ADDED_LINES" | grep -iE 'qr.*(hex|byte|data|prefix|payload).*(log|print|trace|Log\.)' | grep -qv 'test'; then
        echo "  WARNING: Possible QR data in log statement"
        echo "    Rule: never log QR data, even truncated (contains crypto material)."
        echo "    (This is advisory — verify manually. Suppress with // security-scan-ok: reason)"
    fi

    return $EXIT_CODE
}

if ! _security_scan; then
    echo ""
    echo "BLOCKED: Security-pattern scan found violations."
    echo "  Fix the issues above, or add '// security-scan-ok: <reason>' to suppress."
    exit 1
fi

# ─── Rapid-session advisory ────────────────────────────────────────
# Informational warning when pushing many commits — prompts review.

if [[ -n "$BRANCH" && "$BRANCH" != "main" ]]; then
    COMMIT_COUNT=$(git -C "$REPO_ROOT" rev-list --count origin/main..HEAD 2>/dev/null || echo "0")
    if [[ "$COMMIT_COUNT" -ge 5 ]]; then
        echo ""
        echo "Pushing $COMMIT_COUNT commits — rapid session checklist:"
        echo "  - FLAG_SECURE gated on BuildConfig.DEBUG?"
        echo "  - QR data absent from log statements?"
        echo "  - Debug intents guarded?"
        echo "  - Zeroization complete in clear_sensitive()?"
        echo "  (This is informational — push continues)"
        echo ""
    fi
fi

# ─── TDD stamp check ───────────────────────────────────────────────
# If `just check` already passed for this commit, skip all checks.

STAMP_SH="$REPO_ROOT/../scripts/scripts/stamp.sh"
if [[ -f "$STAMP_SH" ]]; then
    source "$STAMP_SH"
    STAMP_REPO=$(stamp_repo_from_dir "$REPO_DIR" 2>/dev/null) || STAMP_REPO=""
    if [[ -n "$STAMP_REPO" ]] && stamp_valid "$STAMP_REPO"; then
        echo ""
        echo "  Stamp valid — skipping checks (just check already passed for HEAD)"
        _STAMP_SKIP=1
    fi
fi

# ─── Non-code change detection ─────────────────────────────────────
# If only docs/config files changed (no source code), skip compile/lint/test
# checks. Doc repos (_private, docs) are exempt — their "code" IS markdown,
# so they fall through to the full doc check block (markdownlint, REUSE,
# doc naming, plan companions).

if [[ "$_STAMP_SKIP" != "1" ]]; then
    CHANGED_FILES=$(git diff --name-only origin/main...HEAD 2>/dev/null || echo "")
    if [[ -n "$CHANGED_FILES" ]]; then
        CODE_PATTERN='\.(rs|swift|kt|java|ts|tsx|js|jsx|css|scss|html)$'
        BUILD_PATTERN='(Cargo\.(toml|lock)|package.*\.json|.*\.gradle)'
        HAS_CODE=$(echo "$CHANGED_FILES" | grep -E "$CODE_PATTERN" || true)
        HAS_BUILD=$(echo "$CHANGED_FILES" | grep -E "$BUILD_PATTERN" || true)
        if [[ -z "$HAS_CODE" && -z "$HAS_BUILD" ]]; then
            # Doc repos (_private, docs) treat .md as code — run full doc checks
            if [[ "$REPO_DIR" == "_private" || "$REPO_DIR" == "docs" ]]; then
                echo ""
                echo "  Only markdown/config files changed — running doc checks"
            else
                echo ""
                echo "  Only non-code files changed — skipping checks"
                _STAMP_SKIP=1
            fi
        fi
    fi
fi

# ─── CI lint (all repos with .gitlab-ci.yml changes) ────────────────

if [[ -f "$REPO_ROOT/.gitlab-ci.yml" ]]; then
    if git diff --name-only origin/main...HEAD 2>/dev/null | grep -q '^\.gitlab-ci\.yml$'; then
        echo ""
        echo "[0] Validating .gitlab-ci.yml..."
        if command -v glab &> /dev/null; then
            # `glab ci lint` POSTs only the top-level file to the server —
            # it cannot resolve `local:` includes (the file path is relative
            # to the repo root on the server, not the client FS). If the
            # top file uses local: includes, skip server-lint and verify
            # instead that every referenced local file exists on disk.
            # The real MR pipeline will do the full lint once pushed.
            if grep -qE '^\s*-\s*local:' "$REPO_ROOT/.gitlab-ci.yml"; then
                echo "  (server lint skipped — local: includes present)"
                local_missing=0
                while read -r inc; do
                    inc_path=$(printf '%s' "$inc" \
                        | sed -E 's/^[[:space:]]*-[[:space:]]*local:[[:space:]]*//; s/^["'\'']//; s/["'\'']$//')
                    [ -z "$inc_path" ] && continue
                    # local: paths are relative to the repo root (with optional leading slash)
                    resolved="${REPO_ROOT}/${inc_path#/}"
                    if [ ! -f "$resolved" ]; then
                        echo "  MISSING local include: $inc_path (resolved to $resolved)"
                        local_missing=1
                    fi
                done < <(grep -E '^\s*-\s*local:' "$REPO_ROOT/.gitlab-ci.yml")
                if [ "$local_missing" = 1 ]; then
                    echo ""
                    echo "FAILED: one or more local: includes point to missing files."
                    exit 1
                fi
                echo "  All local: includes resolve on disk"
            elif ! glab ci lint "$REPO_ROOT/.gitlab-ci.yml" > /dev/null 2>&1; then
                echo ""
                echo "FAILED: CI config is invalid:"
                glab ci lint "$REPO_ROOT/.gitlab-ci.yml" 2>&1
                exit 1
            else
                echo "  CI lint OK"
            fi
        fi

        # Check for jobs without runner tags.
        # All self-hosted runners have run_untagged=false — untagged jobs
        # hang forever in CI with no runner to pick them up.
        # Safe to skip: extends: (inherits tags from template), trigger:
        # (runs on GitLab infra), no script: (template override via include:).
        UNTAGGED=$(awk '
        /^[^[:space:]#%-]/ && /:/ {
            if (job != "" && has_script && !has_tags && !has_extends && !has_trigger && !is_reserved && !is_hidden)
                print "  " job
            job = $0
            sub(/:[[:space:]].*$/, "", job)
            sub(/:$/, "", job)
            has_tags = 0; has_extends = 0; has_script = 0; has_trigger = 0
            is_reserved = (job ~ /^(stages|variables|include|workflow|default|image|before_script|after_script|services|cache)$/)
            is_hidden = (job ~ /^\./)
        }
        /^[[:space:]]+tags:/ { has_tags = 1 }
        /^[[:space:]]+extends:/ { has_extends = 1 }
        /^[[:space:]]+script:/ { has_script = 1 }
        /^[[:space:]]+trigger:/ { has_trigger = 1 }
        END {
            if (job != "" && has_script && !has_tags && !has_extends && !has_trigger && !is_reserved && !is_hidden)
                print "  " job
        }' "$REPO_ROOT/.gitlab-ci.yml")

        if [[ -n "$UNTAGGED" ]]; then
            echo ""
            echo "FAILED: CI jobs without runner tags (will hang — all runners require tags):"
            echo "$UNTAGGED"
            echo ""
            echo "Add tags: [docker] for container jobs, tags: [linux] for shell jobs."
            exit 1
        fi
        echo "  Runner tags OK"
    fi
fi

# ─── Typos auto-fix ───────────────────────────────────────────────────
# Run typos on files changed vs origin/main. If typos found, auto-fix
# them, print what changed, and abort push so user can commit the fixes.

if command -v typos &> /dev/null; then
    CHANGED=$(git diff --name-only origin/main...HEAD 2>/dev/null || echo "")
    if [[ -n "$CHANGED" ]]; then
        # Check only changed files (fast — avoids full-repo scan)
        TYPO_OUTPUT=""
        while IFS= read -r f; do
            [[ -f "$REPO_ROOT/$f" ]] || continue
            result=$(typos --force-exclude "$REPO_ROOT/$f" 2>&1) || TYPO_OUTPUT="${TYPO_OUTPUT}${result}"$'\n'
        done <<< "$CHANGED"

        if [[ -n "$TYPO_OUTPUT" ]]; then
            echo ""
            echo "[typos] Found typos — auto-fixing..."
            while IFS= read -r f; do
                [[ -f "$REPO_ROOT/$f" ]] || continue
                typos --force-exclude --write-changes "$REPO_ROOT/$f" 2>/dev/null || true
            done <<< "$CHANGED"
            echo ""
            echo "$TYPO_OUTPUT"
            echo ""
            echo "FIXED: Typos corrected in working tree. Stage + commit the fixes, then push again."
            exit 1
        fi
    fi
fi

# ─── Markdown linting (all repos) ────────────────────────────────────
# Lint changed .md files vs origin/main. Runs for every repo, not just
# doc repos — READMEs, CONTRIBUTING.md, etc. deserve lint too.

if command -v markdownlint &> /dev/null; then
    MD_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "")
    if [[ -n "$MD_BASE" ]]; then
        # --diff-filter=d: deleted files can't be linted. Without it a
        # deleted path that still resolves on disk (e.g. via the root
        # .claude → _private/.claude symlink) gets linted by accident.
        MD_FILES=$(git diff --name-only --diff-filter=d "$MD_BASE"...HEAD -- '*.md' 2>/dev/null | grep -v '^$' | grep -vE '(^|/)vendor/' || true)
    else
        MD_FILES=$(git ls-files '*.md' 2>/dev/null | grep -vE '(^|/)vendor/' || true)
    fi

    if [[ -n "$MD_FILES" ]]; then
        WS_ROOT="$REPO_ROOT/.."

        # Resolve config: repo-local > _private > workspace root
        MD_CONFIG=""
        if [[ -f "$REPO_ROOT/.markdownlint.json" ]]; then
            MD_CONFIG="$REPO_ROOT/.markdownlint.json"
        elif [[ -f "$REPO_ROOT/.markdownlint.jsonc" ]]; then
            MD_CONFIG="$REPO_ROOT/.markdownlint.jsonc"
        elif [[ -f "$WS_ROOT/_private/.markdownlint.json" ]]; then
            MD_CONFIG="$WS_ROOT/_private/.markdownlint.json"
        elif [[ -f "$WS_ROOT/.markdownlint.json" ]]; then
            MD_CONFIG="$WS_ROOT/.markdownlint.json"
        fi

        MD_ARGS=()
        if [[ -n "$MD_CONFIG" ]]; then
            MD_ARGS+=(-c "$MD_CONFIG")
        fi

        # Use custom line-length rule if available
        CUSTOM_RULE="$WS_ROOT/_private/scripts/markdownlint-rule-line-length.js"
        if [[ -f "$CUSTOM_RULE" ]]; then
            MD_ARGS+=(-r "$CUSTOM_RULE")
        fi

        MD_COUNT=$(echo "$MD_FILES" | wc -l | tr -d ' ')
        echo ""
        echo "[markdownlint] Linting $MD_COUNT changed .md file(s) ($REPO_DIR)..."
        if ! echo "$MD_FILES" | xargs markdownlint "${MD_ARGS[@]}"; then
            echo ""
            echo "FAILED: markdownlint found issues. Run 'just lint-markdown fix' to auto-fix."
            exit 1
        fi
        echo "  Markdown lint OK"
    fi
fi

# ─── CLAUDE.md references / orphan docs (workspace root only) ────────
# Runs when the push touches CLAUDE.md, .claude/docs/, .claude/rules/,
# or .claude/skills/. Script lives in vauchi/scripts — call through
# the sub-repo checkout so CI and local share the same implementation.
# Mirrors CI's lint:claude-md rules so failures surface locally, not
# after a round-trip.

CM_SCRIPT="$REPO_ROOT/scripts/scripts/check-claude-md.sh"
if [[ -f "$REPO_ROOT/CLAUDE.md" && -x "$CM_SCRIPT" ]]; then
    CM_BASE=$(git -C "$REPO_ROOT" merge-base origin/main HEAD 2>/dev/null || echo "")
    if [[ -n "$CM_BASE" ]]; then
        CM_CHANGED=$(git -C "$REPO_ROOT" diff --name-only "$CM_BASE"...HEAD -- \
            CLAUDE.md .claude/docs/ .claude/rules/ .claude/skills/ 2>/dev/null || true)
    else
        CM_CHANGED="CLAUDE.md"
    fi
    if [[ -n "$CM_CHANGED" ]]; then
        echo ""
        echo "[check-claude-md] Validating CLAUDE.md references..."
        if ! (cd "$REPO_ROOT" && "$CM_SCRIPT"); then
            echo ""
            echo "FAILED: CLAUDE.md references / orphan check."
            exit 1
        fi
    fi
fi

if [[ "$_STAMP_SKIP" != "1" ]]; then

# ─── Timing helpers ──────────────────────────────────────────────────

declare -a STEP_NAMES=()
declare -a STEP_TIMES=()

time_step() {
    local step_start=$SECONDS
    local name="$1"
    shift
    "$@"
    local elapsed=$(( SECONDS - step_start ))
    STEP_NAMES+=("$name")
    STEP_TIMES+=("${elapsed}s")
}

# ─── Check for gate-push dedup ──────────────────────────────────────
# If gate-push.sh already ran fmt+clippy for this commit recently, skip those.

_GATE_DEDUP=0
_GATE_DEDUP_FILE="/tmp/.vauchi-gate-${REPO_DIR}-$(git rev-parse HEAD 2>/dev/null || echo none)"
if [[ -f "$_GATE_DEDUP_FILE" ]]; then
    # SHA is embedded in the filename, so if HEAD changes the file won't match.
    # No time-based expiry needed — the SHA guarantees freshness.
    echo ""
    echo "  gate-push already ran fmt+clippy for this commit — skipping those"
    _GATE_DEDUP=1
fi

# ─── Rust repos ──────────────────────────────────────────────────────

WORK_DIR="$REPO_ROOT"
if [[ "$REPO_DIR" == "desktop" ]]; then
    WORK_DIR="$REPO_ROOT/src-tauri"
fi

if [[ -f "$WORK_DIR/Cargo.toml" ]]; then
    cd "$WORK_DIR"

    CLIPPY_EXTRA=()
    # Use nextest if available (12x faster than cargo test)
    if command -v cargo-nextest &> /dev/null; then
        TEST_CMD=(cargo nextest run)
    else
        TEST_CMD=(cargo test)
    fi

    case "$REPO_DIR" in
        core)
            TEST_CMD+=(--workspace)
            ;;
        cli)
            TEST_CMD+=(--all-targets --no-default-features)
            ;;
        tui)
            TEST_CMD+=(--all-targets)
            LOCALES_DIR="$REPO_ROOT/../locales"
            if [[ -d "$LOCALES_DIR" ]]; then
                export VAUCHI_LOCALES_DIR="$LOCALES_DIR"
            fi
            ;;
        desktop)
            CLIPPY_EXTRA=(--no-default-features --features custom-protocol)
            TEST_CMD+=(--all-targets --no-default-features --features custom-protocol)
            ;;
        linux-gtk|linux-qt)
            TEST_CMD+=(--all-targets)
            # These repos have Linux-only deps (bluer, AT-SPI). On non-Linux,
            # only check formatting — clippy/test will fail at compile time.
            if [[ "$(uname)" != "Linux" ]]; then
                echo ""
                echo "  Platform: $(uname) — $REPO_DIR is Linux-only."
                echo "  Running format check only (clippy/tests require Linux)."
                _SKIP_CLIPPY_TEST=1
            fi
            ;;
        *)
            TEST_CMD+=(--all-targets)
            ;;
    esac

    # Skip fmt + clippy + tests when the push touches no Rust source.
    # Prevents pre-existing workspace compile issues from blocking
    # docs/CI/YAML/Python-only pushes that never exercise the Rust
    # build graph. Rust-touching pushes still get fully gated.
    UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
    if [[ -n "$UPSTREAM" ]]; then
        DIFF_RANGE="$UPSTREAM..HEAD"
    else
        DIFF_RANGE="origin/main..HEAD"
    fi
    CHANGED_FILES=$(git diff --name-only "$DIFF_RANGE" 2>/dev/null || true)
    _SKIP_FMT="${_SKIP_FMT:-0}"
    if [[ -n "$CHANGED_FILES" ]] && ! echo "$CHANGED_FILES" \
            | grep -qE '\.(rs|toml)$|(^|/)rust-toolchain\b|(^|/)\.cargo/'; then
        echo ""
        echo "  No Rust changes in $DIFF_RANGE — skipping fmt + clippy + tests."
        _SKIP_FMT=1
        _SKIP_CLIPPY_TEST=1
    fi

    # ── Path-override source freshness (advisory) ──────────────────────
    # Mirror of the session-init + gate-push.sh check: surface stale
    # local core/ before clippy validates against it. Fires here for
    # interactive `git push` (no Claude → no gate-push.sh) so the
    # WARN reaches developers regardless of how they push. Skipped
    # when gate-push already ran the check (dedup) or when this is a
    # docs-only push (no Rust files touched).
    if [[ "$_GATE_DEDUP" != "1" && "$_SKIP_FMT" != "1" ]]; then
        _WORKSPACE_ROOT=$(cd "$REPO_ROOT/.." 2>/dev/null && pwd)
        _FRESHNESS_SCRIPT="$_WORKSPACE_ROOT/scripts/scripts/path-overrides.sh"
        if [[ -n "$_WORKSPACE_ROOT" && -x "$_FRESHNESS_SCRIPT" ]]; then
            _FRESHNESS_OUT=$(cd "$_WORKSPACE_ROOT" && bash "$_FRESHNESS_SCRIPT" freshness 2>/dev/null || true)
            if echo "$_FRESHNESS_OUT" | grep -q '^  WARN:'; then
                echo ""
                echo "⚠ Path-override source drift detected — local clippy/tests below"
                echo "  may pass on stale APIs that CI will reject:"
                echo "$_FRESHNESS_OUT" | sed 's/^/  /'
                echo "  (advisory — not blocking; checks continue)"
                echo ""
            fi
        fi
    fi

    if [[ "$_GATE_DEDUP" != "1" ]]; then
        run_fmt() {
            echo ""
            echo "[1/3] Checking formatting..."
            if ! cargo fmt --all -- --check 2>/dev/null; then
                # On Windows, cargo fmt --all may fail with "filename too long"
                # (os error 206). Fall back to per-package checks.
                PACKAGES=$(cargo metadata --no-deps --format-version=1 2>/dev/null \
                    | jq -r '.packages[].name' 2>/dev/null || true)
                if [[ -n "$PACKAGES" ]]; then
                    FMT_FAIL=0
                    for pkg in $PACKAGES; do
                        if ! cargo fmt -p "$pkg" -- --check 2>/dev/null; then
                            FMT_FAIL=1
                        fi
                    done
                    if [[ $FMT_FAIL -ne 0 ]]; then
                        echo ""
                        echo "FAILED: Format check failed. Run 'cargo fmt --all' to fix."
                        exit 1
                    fi
                else
                    echo ""
                    echo "FAILED: Format check failed. Run 'cargo fmt --all' to fix."
                    exit 1
                fi
            fi
            echo "  Format OK"
        }
        if [[ "${_SKIP_FMT:-}" == "1" ]]; then
            echo ""
            echo "[1/3] Skipping format check (no Rust changes in diff range)"
        else
            time_step "Format" run_fmt
        fi

        if [[ "${_SKIP_CLIPPY_TEST:-}" == "1" ]]; then
            echo ""
            echo "[2/3] Skipping clippy (platform-limited repo on $(uname))"
        else
        run_clippy() {
            echo ""
            echo "[2/3] Running clippy..."
            if ! cargo clippy --all-targets "${CLIPPY_EXTRA[@]}" -- -D warnings; then
                echo ""
                echo "FAILED: Clippy check failed. Fix warnings before pushing."
                exit 1
            fi
            echo "  Clippy OK"
        }
        time_step "Clippy" run_clippy

        # K-H1/K-L4 lint: detect dangerous Clone + manual zeroizing Drop on the SAME type.
        # Safe: #[derive(Clone, Zeroize, ZeroizeOnDrop)] — both copies auto-zeroized.
        # Dangerous: #[derive(Clone)] + manual impl Drop { zeroize() } — clone escapes zeroization.
        run_zeroize_lint() {
            echo ""
            echo "[2.5/3] Checking for dangerous Clone+Zeroize anti-pattern..."
            ZEROIZE_VIOLATIONS=""
            # Use rg (ripgrep) if available — handles binary files safely and avoids
            # Bus errors from BSD grep/sed on large vendored .rs files (e.g. aws-lc-sys).
            if command -v rg &>/dev/null; then
                while IFS=: read -r rs_file type_name; do
                    [[ -z "$type_name" || -z "$rs_file" ]] && continue
                    type_name=$(echo "$type_name" | sed 's/.*impl[[:space:]]*Drop[[:space:]]*for[[:space:]]*//' | sed 's/[[:space:]]*{.*//' | sed 's/[<(].*//')
                    [[ -z "$type_name" ]] && continue
                    if rg -q "derive\(.*Clone" "$rs_file" \
                        && rg -B5 "struct ${type_name}\b|enum ${type_name}\b" "$rs_file" \
                            | rg -q "derive\(.*Clone" \
                        && ! rg -B5 "struct ${type_name}\b|enum ${type_name}\b" "$rs_file" \
                            | rg -q "ZeroizeOnDrop"; then
                        ZEROIZE_VIOLATIONS="$ZEROIZE_VIOLATIONS  $rs_file ($type_name)\n"
                    fi
                done < <(rg -n 'impl Drop for' --type rust --glob '!target/' . 2>/dev/null || true)
            else
                echo "  (rg not found, skipping zeroize lint)"
            fi
            if [[ -n "$ZEROIZE_VIOLATIONS" ]]; then
                echo ""
                echo "FAILED: Found derive(Clone) + manual impl Drop with zeroize() on same type:"
                echo -e "$ZEROIZE_VIOLATIONS"
                echo "Use #[derive(Clone, Zeroize, ZeroizeOnDrop)] instead of manual Drop."
                echo "See: _private/docs/problems/2026-03-02-core-zeroization-gaps/README.md"
                exit 1
            fi
            echo "  Zeroize lint OK"
        }
        time_step "ZeroizeLint" run_zeroize_lint
        fi  # end _SKIP_CLIPPY_TEST guard
    fi

    run_tests() {
        if [[ "${_SKIP_CLIPPY_TEST:-}" == "1" ]]; then
            echo ""
            echo "[3/3] Skipping tests (platform-limited repo on $(uname))"
        elif [[ "${SKIP_TESTS:-}" == "1" ]]; then
            echo ""
            echo "[3/3] Skipping tests (SKIP_TESTS=1)"
        else
            echo ""
            echo "[3/3] Running tests... (set SKIP_TESTS=1 to skip)"
            if ! "${TEST_CMD[@]}"; then
                echo ""
                echo "FAILED: Tests failed. Fix before pushing."
                exit 1
            fi
            echo "  Tests OK"
        fi
    }
    time_step "Tests" run_tests

    # ─── Supply chain verification (cargo vet) ────────────────────────
    # For repos with supply-chain/, verify all deps are audited/trusted.
    # Must temporarily remove .cargo/config.toml if it contains [patch]
    # overrides — path-resolved lockfiles can't be verified with --locked
    # because cargo-vet internally uses --locked for cargo metadata.

    if [[ -d "$REPO_ROOT/supply-chain" ]] && ! command -v cargo-vet &>/dev/null; then
        echo ""
        echo "  [WARN] cargo-vet not installed — skipping supply chain check."
        echo "         Install: cargo binstall cargo-vet"
        echo "         CI will still enforce it on MR."
    fi

    if [[ -d "$REPO_ROOT/supply-chain" ]] && command -v cargo-vet &>/dev/null; then
        run_vet() {
            echo ""
            echo "[4] Checking supply chain (cargo vet)..."

            _VET_CONFIG_MOVED=0
            if [[ -f "$REPO_ROOT/.cargo/config.toml" ]] \
                && grep -q '\[patch' "$REPO_ROOT/.cargo/config.toml" 2>/dev/null; then
                mv "$REPO_ROOT/.cargo/config.toml" "$REPO_ROOT/.cargo/config.toml.vet-bak"
                _VET_CONFIG_MOVED=1
                # Re-resolve git source (path override recorded wrong source in lockfile)
                cargo update 2>/dev/null || true
            fi

            VET_EXIT=0
            cargo vet --locked 2>&1 || VET_EXIT=$?

            if [[ $_VET_CONFIG_MOVED -eq 1 ]]; then
                mv "$REPO_ROOT/.cargo/config.toml.vet-bak" "$REPO_ROOT/.cargo/config.toml"
                # Discard lockfile changes from git source resolution
                git -C "$REPO_ROOT" checkout -- Cargo.lock 2>/dev/null || true
            fi

            if [[ $VET_EXIT -ne 0 ]]; then
                echo ""
                echo "FAILED: Supply chain verification failed."
                echo "  Run 'cargo vet' to see details, 'cargo vet suggest' for fix suggestions."
                exit 1
            fi
            echo "  Supply chain OK"
        }
        time_step "SupplyChain" run_vet
    fi


# ─── Swift/iOS repo ──────────────────────────────────────────────────

elif [[ -f "$REPO_ROOT/Package.swift" ]] || [[ "$REPO_DIR" == "ios" ]]; then
    cd "$REPO_ROOT"

    run_xcodegen() {
        if [[ "$REPO_DIR" == "ios" ]] && command -v xcodegen &>/dev/null; then
            echo ""
            echo "[0] Regenerating Xcode project..."
            xcodegen generate 2>&1
            if ! git diff --quiet Vauchi.xcodeproj/; then
                echo ""
                echo "FAILED: Xcode project is out of date. Run 'xcodegen generate' and commit."
                exit 1
            fi
            echo "  Xcode project up to date"
        fi
    }
    time_step "XcodeGen" run_xcodegen

    run_swiftformat() {
        echo ""
        echo "[1/2] Checking Swift formatting..."
        if command -v swiftformat &> /dev/null; then
            if ! swiftformat --lint . 2>&1; then
                echo ""
                echo "FAILED: SwiftFormat check failed. Run 'swiftformat .' to fix."
                exit 1
            fi
            echo "  SwiftFormat OK"
        else
            echo "  (swiftformat not found, skipping)"
        fi
    }
    time_step "SwiftFormat" run_swiftformat

    run_swiftlint() {
        echo ""
        echo "[2/2] Running SwiftLint..."
        if command -v swiftlint &> /dev/null; then
            LINT_OUTPUT=$(swiftlint lint --strict --quiet 2>&1) || LINT_EXIT=$?
            LINT_EXIT=${LINT_EXIT:-0}
            if [[ $LINT_EXIT -gt 128 ]]; then
                # Tool crashed (signal), not a real lint failure — skip gracefully
                SIGNAL=$((LINT_EXIT - 128))
                echo "  (swiftlint crashed with signal $SIGNAL, skipping — fix your swiftlint installation)"
            elif [[ $LINT_EXIT -ne 0 ]]; then
                echo "$LINT_OUTPUT"
                echo ""
                echo "FAILED: SwiftLint found violations. Fix before pushing."
                exit 1
            else
                echo "  SwiftLint OK"
            fi
        else
            echo "  (swiftlint not found, skipping)"
        fi
    }
    time_step "SwiftLint" run_swiftlint

# ─── Android/Kotlin repo ─────────────────────────────────────────────

elif [[ "$REPO_DIR" == "android" ]]; then
    cd "$REPO_ROOT"

    run_kotlin_compile() {
        echo ""
        echo "[1/2] Compiling Kotlin..."
        if [[ -x "$REPO_ROOT/gradlew" ]]; then
            # Use -PlocalBindings when local bindings are present (new types not yet in Maven AAR)
            GRADLE_ARGS=""
            if [[ -d "$REPO_ROOT/app/src/local-bindings/kotlin/uniffi" ]]; then
                GRADLE_ARGS="-PlocalBindings"
                echo "  Local bindings detected, using -PlocalBindings"
            fi
            if ! ./gradlew compileDebugKotlin $GRADLE_ARGS --quiet 2>&1; then
                echo ""
                echo "FAILED: Kotlin compilation failed. Fix errors before pushing."
                exit 1
            fi
            echo "  Compilation OK"
        else
            echo "  (gradlew not found, skipping)"
        fi
    }
    time_step "Kotlin compile" run_kotlin_compile

    run_android_lint() {
        echo ""
        echo "[2/2] Running Android lint..."
        if [[ -x "$REPO_ROOT/gradlew" ]]; then
            if ! ./gradlew lint $GRADLE_ARGS --quiet 2>&1; then
                echo ""
                echo "FAILED: Android lint failed. Fix before pushing."
                exit 1
            fi
            echo "  Lint OK"
        else
            echo "  (gradlew not found, skipping)"
        fi
    }
    time_step "Android lint" run_android_lint

# ─── Docs/markdown repos (_private, docs) ───────────────────────────

elif [[ "$REPO_DIR" == "_private" ]] || [[ "$REPO_DIR" == "docs" ]]; then
    cd "$REPO_ROOT"

    run_markdownlint_check() {
        echo ""
        echo "[1/9] Linting markdown..."
        if command -v markdownlint &> /dev/null; then
            # Lint only .md files changed on this branch vs origin/main
            MD_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "")
            if [[ -n "$MD_BASE" ]]; then
                MD_FILES=$(git diff --name-only --diff-filter=d "$MD_BASE"...HEAD -- '*.md' 2>/dev/null | grep -v '^$' || true)
            else
                MD_FILES=$(git ls-files '*.md' 2>/dev/null || true)
            fi

            if [[ -n "$MD_FILES" ]]; then
                WS_ROOT="$REPO_ROOT/.."

                # Resolve config: repo-local > _private > workspace root
                MD_CONFIG=""
                if [[ -f "$REPO_ROOT/.markdownlint.json" ]]; then
                    MD_CONFIG="$REPO_ROOT/.markdownlint.json"
                elif [[ -f "$REPO_ROOT/.markdownlint.jsonc" ]]; then
                    MD_CONFIG="$REPO_ROOT/.markdownlint.jsonc"
                elif [[ -f "$WS_ROOT/_private/.markdownlint.json" ]]; then
                    MD_CONFIG="$WS_ROOT/_private/.markdownlint.json"
                elif [[ -f "$WS_ROOT/.markdownlint.json" ]]; then
                    MD_CONFIG="$WS_ROOT/.markdownlint.json"
                fi

                MD_ARGS=()
                if [[ -n "$MD_CONFIG" ]]; then
                    MD_ARGS+=(-c "$MD_CONFIG")
                fi

                # Use custom line-length rule if available
                CUSTOM_RULE="$WS_ROOT/_private/scripts/markdownlint-rule-line-length.js"
                if [[ -f "$CUSTOM_RULE" ]]; then
                    MD_ARGS+=(-r "$CUSTOM_RULE")
                fi

                MD_COUNT=$(echo "$MD_FILES" | wc -l | tr -d ' ')
                echo "  Linting $MD_COUNT changed .md file(s)..."
                if ! echo "$MD_FILES" | xargs markdownlint "${MD_ARGS[@]}"; then
                    echo ""
                    echo "FAILED: markdownlint found issues. Run 'just lint-markdown fix' to auto-fix."
                    exit 1
                fi
                echo "  Markdown lint OK"
            else
                echo "  No .md files changed, skipping"
            fi
        else
            echo "  (markdownlint not found, skipping — install with: npm install -g markdownlint-cli)"
        fi
    }
    time_step "Markdown lint" run_markdownlint_check

    run_reuse_check() {
        echo ""
        echo "[2/9] Checking REUSE compliance..."
        if command -v reuse &> /dev/null; then
            if ! reuse lint > /dev/null 2>&1; then
                echo ""
                echo "FAILED: REUSE compliance check failed:"
                reuse lint 2>&1 | tail -30
                exit 1
            fi
            echo "  REUSE lint OK"
        else
            # Fallback: basic SPDX header check on new markdown files
            MISSING=0
            for file in $(git diff --name-only --diff-filter=A origin/main...HEAD -- '*.md' 2>/dev/null); do
                if ! head -2 "$file" | grep -q 'SPDX-'; then
                    echo "  MISSING SPDX header: $file"
                    MISSING=$((MISSING + 1))
                fi
            done
            if [[ $MISSING -gt 0 ]]; then
                echo ""
                echo "FAILED: $MISSING new file(s) missing SPDX headers. Install 'reuse' for full check."
                exit 1
            fi
            echo "  SPDX headers OK (basic check — install 'reuse' for full compliance check)"
        fi
    }
    time_step "REUSE" run_reuse_check

    run_doc_naming_check() {
        echo ""
        echo "[3/9] Checking doc naming convention..."
        ERRORS=0
        EXEMPT_NAMES="README.md|CLAUDE.md|CONTRIBUTING.md|roadmap.md|PRINCIPLES.md|INDEX.md"
        EXEMPT_COMPANION="investigation.md|implementation-plan.md|retrospective.md|post-mortem.md|rejected-solutions.md|design.md|plan.md|principles-audit.md"
        EXEMPT_DIRS="diagrams|guides|reference|knowledge|testing|audit-review-frameworks|legal|decisions|lint-errors|archive|runbooks|audits"
        for file in $(git diff --name-only --diff-filter=A origin/main...HEAD -- 'docs/**/*.md' 2>/dev/null); do
            filename=$(basename "$file")
            dirname=$(dirname "$file")
            # Skip exempt filenames
            if echo "$filename" | grep -qE "^($EXEMPT_NAMES)$"; then continue; fi
            if echo "$filename" | grep -qE "^($EXEMPT_COMPANION)$"; then continue; fi
            if echo "$filename" | grep -qE '\.plan\.md$'; then continue; fi
            if echo "$dirname" | grep -qE "($EXEMPT_DIRS)"; then continue; fi
            if [[ "$dirname" == "docs" ]]; then continue; fi
            if ! echo "$filename" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-'; then
                echo "  ERROR: $file does not follow YYYY-MM-DD-name.md convention"
                ERRORS=$((ERRORS + 1))
            fi
        done
        if [[ $ERRORS -gt 0 ]]; then
            echo ""
            echo "FAILED: $ERRORS file(s) not following naming convention."
            exit 1
        fi
        echo "  Doc naming OK"
    }
    time_step "Doc naming" run_doc_naming_check

    run_plan_presence_check() {
        echo ""
        echo "[4/9] Checking plan.md companions..."
        ERRORS=0
        # 1. Problem records in planning/implementing status with implementation-plan.md
        # should have plan.md (task DAG). Skip intake/investigating (too early),
        # done/ (historical), and records where implementation-plan.md has tasks.
        for impl in $(find docs/problems -not -path "*/done/*" -name "implementation-plan.md" 2>/dev/null); do
            dir=$(dirname "$impl")
            [ -f "$dir/plan.md" ] && continue
            # Accept implementation-plan.md as the plan if it contains task checkboxes
            if grep -q '^\- \[' "$impl" 2>/dev/null; then continue; fi
            # Skip intake/investigating — too early for a plan requirement
            if [ -f "$dir/README.md" ]; then
                status=$(grep -oE 'Status.*`(intake|investigating)`' "$dir/README.md" 2>/dev/null)
                if [ -n "$status" ]; then continue; fi
            fi
            echo "  MISSING: $dir/plan.md (has implementation-plan.md with no task checkboxes)"
            ERRORS=$((ERRORS + 1))
        done

        # 2. Planning todo docs must have companion .plan.md (task DAG)
        # Skip: .plan.md files (ARE task DAGs), -plan.md files (ARE narrative plans)
        # Search: sibling, then planning/todo/, designs/, planning/ by slug match
        for doc in docs/planning/todo/20*.md; do
            [ -f "$doc" ] || continue
            case "$doc" in *.plan.md) continue ;; *-plan.md) continue ;; esac
            # Check for opt-out marker (standalone plans without task DAGs)
            grep -q '<!-- no-plan-companion -->' "$doc" 2>/dev/null && continue
            plan="${doc%.md}.plan.md"
            [ -f "$plan" ] && continue
            # Extract slug (strip YYYY-MM-DD- prefix)
            base=$(basename "$doc" .md)
            slug="${base#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}"
            found=0
            for p in docs/planning/todo/*"${slug}"*.plan.md docs/designs/*"${slug}"*.plan.md docs/planning/*"${slug}"*.plan.md; do
                if [ -f "$p" ]; then found=1; break; fi
            done
            if [ "$found" -eq 0 ]; then
                echo "  MISSING: $plan"
                ERRORS=$((ERRORS + 1))
            fi
        done

        if [[ $ERRORS -gt 0 ]]; then
            echo ""
            echo "FAILED: $ERRORS missing companion plan(s)."
            exit 1
        fi
        echo "  Plan companions OK"
    }
    time_step "Plan check" run_plan_presence_check

    run_local_link_check() {
        echo ""
        echo "[5/9] Checking local file links..."
        if command -v lychee &> /dev/null; then
            MD_BASE=$(git merge-base origin/main HEAD 2>/dev/null || echo "")
            if [[ -n "$MD_BASE" ]]; then
                LINK_FILES=$(git diff --name-only --diff-filter=d "$MD_BASE"...HEAD -- '*.md' 2>/dev/null | grep -v '^$' || true)
            else
                LINK_FILES=""
            fi
            if [[ -n "$LINK_FILES" ]]; then
                LINK_ERRORS=""
                while IFS= read -r f; do
                    [[ -f "$f" ]] || continue
                    result=$(lychee --offline --no-progress --format compact "$f" 2>&1) || LINK_ERRORS="${LINK_ERRORS}${result}"$'\n'
                done <<< "$LINK_FILES"
                if [[ -n "$LINK_ERRORS" ]]; then
                    echo ""
                    echo "$LINK_ERRORS"
                    echo ""
                    echo "FAILED: Broken local links found."
                    echo "  Fix the file paths, then push again."
                    exit 1
                fi
                echo "  Local links OK"
            else
                echo "  No .md files changed, skipping"
            fi
        else
            echo "  (lychee not found, skipping — install with: cargo install lychee)"
        fi
    }
    time_step "Link check" run_local_link_check

    run_stale_ref_check() {
        echo ""
        echo "[6/9] Checking stale references (ADR-027 + RC-3)..."

        # If the authoritative checker exists, delegate to it in MR-diff mode.
        # Same script CI runs — keeps pre-push and CI in sync, and catches
        # RC-3 (vauchi-core/src/ui/ → vauchi-app/src/ui/ rename) which the
        # inline grep below does not cover.
        local checker="$REPO_DIR/scripts/check-adr-references.sh"
        if [[ -x "$checker" ]]; then
            local base
            base=$(git -C "$REPO_DIR" merge-base origin/main HEAD 2>/dev/null || echo "")
            if [[ -n "$base" ]] && (cd "$REPO_DIR" && bash "$checker" --diff "$base" 2>&1); then
                echo "  ADR refs OK (delegated to $checker)"
                return 0
            elif [[ -n "$base" ]]; then
                # Script printed its own error context; block push.
                echo "" >&2
                echo "Push blocked: stale ADR references introduced in this branch." >&2
                echo "  Fix the paths above (see $checker) before pushing." >&2
                exit 2
            fi
            # No merge-base: fall through to inline heuristic.
        fi

        # Fallback inline heuristic (warning only — does not block push)
        #
        # Exclusions:
        #   done/archived  — resolved records
        #   deferred/      — parked work, low-signal noise
        #   ~~             — strikethrough (including multiline opening)
        #   ADR-027        — explicit archival annotations
        #   changelog/evidence — historical records
        #   web-demo       — SolidJS in web-demo is live, not archived desktop
        #   grep -rn       — code blocks containing the checker's own patterns
        #   stale_refs=    — shell variable assignments in code blocks
        #   - [x]          — checked-off plan items
        # ADR-027: the archived Tauri desktop lived at desktop/src-tauri/ and
        # desktop/ui/src/. Flag references to those *paths* — the concrete stale
        # signal — not the bare word "desktop", which is legitimate shorthand for
        # the native desktop frontends (linux-gtk/linux-qt/macos/windows) and was
        # false-positiving on category labels ("desktop/TUI/web"), commit-message
        # quotes, and the rot-audit that documents the Tauri removal. SolidJS
        # under desktop/ui/src is caught by the path; live web-demo SolidJS is
        # not (correct). Mirrors _private/scripts/check-adr-references.sh, which
        # is already path-based. (Tightened 2026-07-12 from a broad `desktop/` +
        # bare `Tauri|SolidJS` grep that required an ever-growing exclusion list.)
        stale_refs=$(grep -rnE 'desktop/src-tauri/|desktop/ui/src/' --include='*.md' \
            docs/problems/ docs/planning/todo/ 2>/dev/null \
            | grep -v 'done/' \
            | grep -v 'archived' \
            | grep -v 'deferred/' \
            | grep -v '~~' \
            | grep -v 'ADR-027' \
            | grep -v 'grep -rnE' \
            | grep -v 'stale_refs=' || true)

        combined="${stale_refs}"
        if [[ -n "$combined" ]]; then
            echo "  WARNING: Stale references to archived desktop/Tauri/SolidJS:"
            echo "$combined" | head -10
            echo "  Per ADR-027: desktop = linux-gtk + linux-qt + macos + windows"
            echo "  Update or strike through these references."
        else
            echo "  ADR-027 stale refs OK"
        fi
    }
    time_step "Stale refs" run_stale_ref_check

    run_problem_records_check() {
        if [[ "$REPO_DIR" == "_private" ]]; then
            echo ""
            echo "[7/9] Validating problem records..."
            if [[ -f "scripts/check-problem-records.py" ]]; then
                if ! python3 scripts/check-problem-records.py; then
                    echo ""
                    echo "FAILED: Problem records validation failed."
                    exit 1
                fi
                echo "  Problem records OK"
            fi
        fi
    }
    time_step "Problem records" run_problem_records_check

    run_adr_index_check() {
        # ADR index gate (mirrors CI `check:adr-index`) — only fires
        # in `_private` when an ADR file or the index README changes,
        # matching the CI rule's `docs/decisions/**/*` change-trigger.
        # Adding a new ADR without regenerating the index would
        # otherwise pass pre-push and fail CI a few minutes later;
        # this lights up the same gate before the push leaves the
        # working tree.
        if [[ "$REPO_DIR" != "_private" ]]; then
            return 0
        fi
        local generator="docs/decisions/generate-index.sh"
        local index_md="docs/decisions/README.md"
        if [[ ! -x "$generator" ]] || [[ ! -f "$index_md" ]]; then
            return 0
        fi
        # Match the CI change rule: only run when an ADR file or the
        # index itself is part of this branch's diff vs origin/main.
        if ! git diff --name-only origin/main...HEAD 2>/dev/null \
            | grep -qE '^docs/decisions/'; then
            return 0
        fi
        echo ""
        echo "[8/9] Checking ADR index freshness..."
        local before_snapshot
        before_snapshot=$(mktemp)
        cp "$index_md" "$before_snapshot"
        # Run generator; on failure, restore + abort. Generator writes
        # to $index_md in-place, so we save & restore around the diff
        # to keep the working tree untouched on a clean pass.
        if ! bash "$generator" docs/decisions >/dev/null 2>&1; then
            cp "$before_snapshot" "$index_md"
            rm -f "$before_snapshot"
            echo "FAILED: $generator exited non-zero. Run it manually to see the error."
            exit 1
        fi
        if ! diff -q "$index_md" "$before_snapshot" >/dev/null 2>&1; then
            # Stale — restore the working tree so the user's diff
            # stays clean, then point at the fix.
            cp "$before_snapshot" "$index_md"
            rm -f "$before_snapshot"
            echo "FAILED: ADR index ($index_md) is stale."
            echo "  Fix: bash $generator docs/decisions && git add $index_md"
            exit 1
        fi
        rm -f "$before_snapshot"
        echo "  ADR index OK"
    }
    time_step "ADR index" run_adr_index_check

    run_adr_paths_check() {
        # ADR source-path freshness (lint-adr-paths.sh pass 2). Only
        # _private carries ADRs; docs/ shares this block but has none.
        if [[ "$REPO_DIR" != "_private" ]]; then
            return 0
        fi
        local linter="docs/decisions/lint-adr-paths.sh"
        if [[ ! -x "$linter" ]]; then
            return 0
        fi
        # Only when this push touches ADRs (mirrors the index gate).
        if ! git diff --name-only origin/main...HEAD 2>/dev/null \
            | grep -qE '^docs/decisions/'; then
            return 0
        fi
        echo ""
        echo "[9/9] Checking ADR source-path freshness..."
        # Pass 2 needs the sibling repos (core/, ios/, etc.) at the
        # workspace root -- the parent of this _private checkout. In a
        # standalone or CI checkout they are absent and the linter
        # announces a skip rather than failing, so this is a no-op there.
        local ws_root
        ws_root="$(dirname "$REPO_ROOT")"
        if bash "$linter" docs/decisions "$ws_root"; then
            echo "  ADR paths OK"
        else
            echo "FAILED: an ADR cites a source path that does not exist."
            echo "  - Stale ADR ref: fix the path in the ADR."
            echo "  - File intentionally removed by that ADR: mark the line"
            echo "    with  \`path\` <!-- adr-lint:ignore-path <reason> -->"
            echo "  - Stale local sibling checkout: refresh it (e.g. just"
            echo "    sync) so the cited files are present, then re-push."
            exit 1
        fi
    }
    time_step "ADR paths" run_adr_paths_check


# ─── Unknown repo type ───────────────────────────────────────────────

else
    echo "  No recognized project type, skipping checks."
    exit 0
fi

fi  # end _STAMP_SKIP guard

# ─── File size gate ───────────────────────────────────────────────────
# Runs OUTSIDE the stamp skip guard because `just check` does not run
# file-size checks. Only checks files changed on this branch (fast).

if [[ -f "$REPO_ROOT/Cargo.toml" || -f "${REPO_ROOT}/src-tauri/Cargo.toml" ]]; then
    if [[ -n "$BRANCH" && "$BRANCH" != "main" ]]; then
        WORKSPACE_ROOT="$(dirname "$REPO_ROOT")"
        SIZE_SCRIPT="$WORKSPACE_ROOT/scripts/scripts/check-file-size.sh"
        if [[ -x "$SIZE_SCRIPT" ]]; then
            # Collect .rs files changed on this branch
            CHANGED_RS=$(git -C "$REPO_ROOT" diff --name-only origin/main...HEAD -- '*.rs' 2>/dev/null \
                | grep -v '^target/' | grep -vE '(^|/)vendor/' || true)
            if [[ -n "$CHANGED_RS" ]]; then
                echo ""
                echo "Checking file sizes..."
                SIZE_FAIL=0
                while IFS= read -r rs_file; do
                    full_path="$REPO_ROOT/$rs_file"
                    [[ -f "$full_path" ]] || continue
                    lines=$(wc -l < "$full_path" | tr -d ' ')

                    # Determine thresholds based on test vs source
                    case "$rs_file" in
                        */tests/*|*_test.rs|*_tests.rs)
                            error_threshold=1200
                            kind="test" ;;
                        *)
                            error_threshold=1000
                            kind="src" ;;
                    esac

                    # Check suppression (// allow(large_file) on line 1)
                    if head -1 "$full_path" 2>/dev/null | grep -q '//.*allow(large_file)'; then
                        continue
                    fi

                    # Check baseline
                    BASELINE_FILE="$REPO_ROOT/.file-size-baseline"
                    baseline=""
                    if [[ -f "$BASELINE_FILE" ]]; then
                        baseline=$(grep -E "^${rs_file} " "$BASELINE_FILE" 2>/dev/null \
                            | awk '{print $2}' || true)
                    fi

                    if [[ -n "$baseline" ]]; then
                        # Grandfathered: only fail if it grew beyond baseline
                        if [[ "$lines" -gt "$baseline" ]]; then
                            echo "  FAIL $rs_file ($lines lines, baseline $baseline — grew by $((lines - baseline)))"
                            SIZE_FAIL=1
                        fi
                    elif [[ "$lines" -gt "$error_threshold" ]]; then
                        echo "  FAIL $rs_file ($lines lines, $kind error threshold $error_threshold)"
                        SIZE_FAIL=1
                    fi
                done <<< "$CHANGED_RS"
                if [[ "$SIZE_FAIL" -eq 1 ]]; then
                    echo ""
                    echo "BLOCKED: File size limit exceeded."
                    echo "  Split the file, add to .file-size-baseline, or add '// allow(large_file)' on line 1."
                    echo "  Run 'just lint-file-size $REPO_DIR' for the full report."
                    exit 1
                fi
                echo "  File sizes OK"
            fi
        fi
    fi
fi

# ─── New test annotation gate ─────────────────────────────────────────
# Runs OUTSIDE the stamp skip guard because `just check` does not run
# annotation checks. Must always run for Rust repos on feature branches.

if [[ -f "$REPO_ROOT/Cargo.toml" || -f "${REPO_ROOT}/src-tauri/Cargo.toml" ]]; then
    if [[ -n "$BRANCH" && "$BRANCH" != "main" ]]; then
        WORKSPACE_ROOT="$(dirname "$REPO_ROOT")"
        ANN_SCRIPT="$WORKSPACE_ROOT/scripts/scripts/check-new-test-annotations.sh"
        if [[ -x "$ANN_SCRIPT" ]]; then
            ORIGIN_MAIN=$(git -C "$REPO_ROOT" rev-parse origin/main 2>/dev/null || true)
            if [[ -n "$ORIGIN_MAIN" ]]; then
                MERGE_BASE=$(git -C "$REPO_ROOT" merge-base HEAD "$ORIGIN_MAIN" 2>/dev/null || true)
                if [[ -n "$MERGE_BASE" ]]; then
                    echo ""
                    echo "Checking new test annotations..."
                    if ! "$ANN_SCRIPT" "$MERGE_BASE" HEAD; then
                        echo ""
                        echo "BLOCKED: New tests without @scenario or @internal annotations."
                        echo "  The CI gate (quality:new-test-annotations) would also block this MR."
                        exit 1
                    fi
                fi
            fi
        fi
    fi
fi

# ─── Summary ─────────────────────────────────────────────────────────

HOOK_ELAPSED=$(( SECONDS - HOOK_START ))

echo ""
echo "=== All pre-push checks passed (${HOOK_ELAPSED}s) ==="
echo ""
for i in "${!STEP_NAMES[@]}"; do
    printf "  %-20s %s\n" "${STEP_NAMES[$i]}" "${STEP_TIMES[$i]}"
done

# ─── Show MRs for this branch ────────────────────────────────────────

cd "$REPO_ROOT"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

if [[ "$BRANCH" != "main" ]] && command -v glab &> /dev/null; then
    echo ""
    # Timestamp from hook start minus 2 minute buffer
    SINCE="$(date -u -v-$((HOOK_ELAPSED + 120))S '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null \
          || date -u -d "$((HOOK_ELAPSED + 120)) seconds ago" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null \
          || echo "")"

    # Open MRs for this branch
    OPEN_MRS="$(glab mr list --source-branch="$BRANCH" --state=opened 2>/dev/null)" || OPEN_MRS=""
    if [[ -n "$OPEN_MRS" ]]; then
        echo "Open MRs on branch $BRANCH:"
        echo "$OPEN_MRS"
    else
        echo "No open MR for branch $BRANCH"

        # Guard: block push to a branch whose MR was already merged.
        # Pushing to such a branch silently recreates it on the remote,
        # orphaning the commits (they won't be in any MR).
        MERGED_MRS="$(glab mr list --source-branch="$BRANCH" --state=merged 2>/dev/null)" || MERGED_MRS=""
        if [[ -n "$MERGED_MRS" && "${ALLOW_MERGED_BRANCH:-}" != "1" ]]; then
            echo ""
            echo "ERROR: Branch $BRANCH has a merged MR:"
            echo "$MERGED_MRS"
            echo ""
            echo "Pushing to a merged branch silently orphans your commits."
            echo "Create a new branch instead:  git checkout -b <new-branch>"
            echo ""
            echo "To override: ALLOW_MERGED_BRANCH=1 git push"
            exit 1
        fi
    fi

    # Recently merged MRs (informational, for branches with open MRs)
    if [[ -n "$OPEN_MRS" && -n "$SINCE" ]]; then
        OTHER_MERGED="$(glab mr list --source-branch="$BRANCH" --state=merged 2>/dev/null)" || OTHER_MERGED=""
        if [[ -n "$OTHER_MERGED" ]]; then
            RECENT=""
            while IFS= read -r line; do
                MR_NUM="$(echo "$line" | grep -oE '![0-9]+' | head -1 | tr -d '!')"
                if [[ -n "$MR_NUM" ]]; then
                    MERGED_AT="$(glab api "projects/:id/merge_requests/$MR_NUM" 2>/dev/null \
                               | jq -r '.merged_at // ""' 2>/dev/null)" || MERGED_AT=""
                    if [[ -n "$MERGED_AT" && "$MERGED_AT" > "$SINCE" ]]; then
                        RECENT="${RECENT}${line}\n"
                    fi
                fi
            done <<< "$OTHER_MERGED"
            if [[ -n "$RECENT" ]]; then
                echo ""
                echo "Recently merged MRs on branch $BRANCH:"
                echo -e "$RECENT"
            fi
        fi
    fi
fi
