# Extracted so it can be unit-tested: the previous inline version
# discarded glab's stderr, so when glab 1.109 removed `--state` the
# merged-branch guard stopped firing without a visible symptom.
# See tests/mr-report.test.sh.
"$HOOK_DIR/lib/mr-report.sh" "$REPO_ROOT" "$BRANCH" "$((HOOK_ELAPSED + 120))" || exit 1
