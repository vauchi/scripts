#!/bin/bash
# Pre-commit hook: Enforces code quality and test structure rules
# Install with: ./install-hooks.sh
#
# Checks performed:
# 1. Spell check (typos)
# 2. Rust formatting (cargo fmt)
# 3. Inline test markers (INLINE_TEST_REQUIRED)
# 4. No secrets in staged files
# 5. Shell portability (shellcheck + custom GNU/BSD linter)
# 6. Commit scope warning (non-blocking)

set -euo pipefail

echo "=== Pre-commit checks ==="

# ============================================================
# 1. Spell check (typos) — fast, runs on staged files only
# ============================================================
echo "[1/4] Checking spelling..."

if command -v typos &> /dev/null; then
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
    if [[ -n "$STAGED_FILES" ]]; then
        # Run typos on staged files only (fast — typically <100ms)
        TYPO_ERRORS=""
        for f in $STAGED_FILES; do
            [[ -f "$f" ]] || continue
            result=$(typos --force-exclude "$f" 2>&1) || TYPO_ERRORS="${TYPO_ERRORS}${result}\n"
        done
        if [[ -n "$TYPO_ERRORS" ]]; then
            echo ""
            printf "%b" "$TYPO_ERRORS"
            echo ""
            echo "ERROR: Typos found in staged files."
            echo "Fix them or add exceptions to _typos.toml"
            exit 1
        fi
        echo "  Spelling OK"
    else
        echo "  No files staged, skipping"
    fi
else
    echo "  (typos not installed — cargo install typos-cli)"
fi

# ============================================================
# 1.5. Block setup-path-overrides leakage in staged Cargo.toml/Cargo.lock
# ============================================================
# `just setup-path-overrides` writes a fenced `[patch.<gitlab>]` block
# into consumer repos' Cargo.toml so local cargo resolves vauchi-* via
# path overrides instead of git URLs. Both Cargo.toml AND Cargo.lock
# are tracked — neither piece of state must land in a commit.
# See problem record `2026-05-03-cargo-path-override-broken`.

PATCH_FENCE_MARKER="# >>> setup-path-overrides BEGIN"

# Cargo.toml carrying the fenced patch block.
STAGED_CARGO_TOML=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '(^|/)Cargo\.toml$' || true)
TOML_FOUND=""
for f in $STAGED_CARGO_TOML; do
    [[ -f "$f" ]] || continue
    if git diff --cached -- "$f" | grep -qF "$PATCH_FENCE_MARKER"; then
        TOML_FOUND="${TOML_FOUND}${f}\n"
    fi
done

# Cargo.lock with vauchi-* pointing at a local sibling path — produced
# by `cargo update -p vauchi-*` after the patch is applied. Detection
# pattern: a `name = "vauchi-(core|app|protocol|relay)"` block whose
# `source` line is missing or starts with the path scheme.
#
# A workspace's OWN crate (e.g. `vauchi-relay` in relay/Cargo.lock,
# `vauchi-core`/`vauchi-app`/`vauchi-protocol`/`vauchi-cabi` in
# core/Cargo.lock) also has no `source = ` line — by definition,
# workspace members are local. Those entries are NOT path overrides
# and must be skipped, otherwise this check fires false positives on
# every commit that touches Cargo.lock in any vauchi-* repo.
STAGED_CARGO_LOCK=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '(^|/)Cargo\.lock$' || true)
LOCK_FOUND=""
for f in $STAGED_CARGO_LOCK; do
    [[ -f "$f" ]] || continue
    # Resolve the sibling Cargo.toml so we can ask cargo metadata what
    # this workspace's own packages are. Skip those names below — they
    # are legitimately source-less.
    LOCK_DIR=$(dirname "$f")
    [[ "$LOCK_DIR" == "." ]] && LOCK_DIR="$(pwd)"
    OWN_PACKAGES=""
    if command -v cargo &>/dev/null && [[ -f "$LOCK_DIR/Cargo.toml" ]]; then
        OWN_PACKAGES=$(cargo metadata \
            --no-deps \
            --format-version=1 \
            --manifest-path "$LOCK_DIR/Cargo.toml" 2>/dev/null \
            | grep -oE '"name":"vauchi-[a-z]+"' \
            | sed 's/"name":"//; s/"$//' \
            | sort -u | tr '\n' '|' | sed 's/|$//' || true)
    fi
    # Build the awk filter. If OWN_PACKAGES is empty (cargo missing
    # or unparsable), fall back to checking all vauchi-* names — same
    # behaviour as before this fix.
    NAME_RE='^name = "vauchi-(core|app|protocol|relay)"'
    SKIP_RE=''
    if [[ -n "$OWN_PACKAGES" ]]; then
        SKIP_RE="$OWN_PACKAGES"
    fi
    # Walk every vauchi-* package block in the staged version. If the
    # block has no `source = "git+..."` line within 4 lines of `name =`,
    # AND the name is not the workspace's own crate, it's been
    # rewritten to a path source and must not commit.
    HAS_PATH_SOURCE=$(git show ":$f" 2>/dev/null \
        | awk -v skip_re="$SKIP_RE" -v name_re="$NAME_RE" '
            BEGIN { use_skip = (skip_re != "") }
            /^\[\[package\]\]/ { in_pkg = 1; name = ""; pkg_name = ""; src = ""; next }
            in_pkg && $0 ~ name_re {
                name = $0
                # Extract bare package name for skip-list comparison.
                match($0, /vauchi-[a-z]+/)
                pkg_name = substr($0, RSTART, RLENGTH)
            }
            in_pkg && /^source = / { src = $0 }
            in_pkg && /^$/ {
                if (name != "" && src == "") {
                    if (!use_skip || pkg_name !~ ("^(" skip_re ")$")) {
                        print name
                    }
                }
                in_pkg = 0
            }
            END {
                if (in_pkg && name != "" && src == "") {
                    if (!use_skip || pkg_name !~ ("^(" skip_re ")$")) {
                        print name
                    }
                }
            }
        ' || true)
    if [[ -n "$HAS_PATH_SOURCE" ]]; then
        LOCK_FOUND="${LOCK_FOUND}${f} (path-sourced: $(echo "$HAS_PATH_SOURCE" | tr '\n' ' '))\n"
    fi
done

if [[ -n "$TOML_FOUND" || -n "$LOCK_FOUND" ]]; then
    echo ""
    echo "ERROR: setup-path-overrides leakage detected in staged files."
    if [[ -n "$TOML_FOUND" ]]; then
        echo ""
        echo "  Cargo.toml carries the override fence:"
        printf "%b" "$TOML_FOUND" | sed 's/^/    /'
    fi
    if [[ -n "$LOCK_FOUND" ]]; then
        echo ""
        echo "  Cargo.lock has vauchi-* on a local path source:"
        printf "%b" "$LOCK_FOUND" | sed 's/^/    /'
    fi
    echo ""
    echo "Fix:"
    echo "  just clean-path-overrides     # strip Cargo.toml fence"
    echo "  cargo update --offline        # restore Cargo.lock to git revs"
    echo "  git add <files> && retry the commit"
    echo ""
    echo "These are local-dev artifacts — committing them breaks CI."
    exit 1
fi

# ============================================================
# 1.6. Workspace dependency version alignment
# ============================================================
# When workspace.package.version is bumped, [workspace.dependencies]
# entries for workspace members must be bumped too. Mismatches break
# golden fixture version checks (core_version vs CARGO_PKG_VERSION)
# and can mislead downstream consumers resolving version requirements.
echo "[1.6/6] Checking workspace dependency version alignment..."
STAGED_CARGO_TOML_ROOT=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '(^|/)Cargo\.toml$' || true)
if [[ -n "$STAGED_CARGO_TOML_ROOT" ]]; then
    WS_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)/.."
    VERSION_CHECK_SCRIPT="$WS_ROOT/scripts/scripts/check-workspace-versions.sh"
    if [[ -x "$VERSION_CHECK_SCRIPT" ]]; then
        for f in $STAGED_CARGO_TOML_ROOT; do
            [[ -f "$f" ]] || continue
            # Only workspace-root Cargo.toml files have [workspace.package].
            if grep -q '^\[workspace\.package\]' "$f"; then
                if ! "$VERSION_CHECK_SCRIPT" "$f"; then
                    echo ""
                    echo "Fix: align workspace.dependencies versions with workspace.package.version."
                    exit 1
                fi
            fi
        done
    fi
fi

# ============================================================
# 1.7. ADR-046: forbid `hpke::Aead::Aes(128|256)Gcm` in staged Rust files
# ============================================================
# HPKE-internal AEAD is bound to ChaCha20-Poly1305 by ADR-046 to
# preserve ADR-019's anti-AES intent and avoid a per-envelope
# fingerprinting vector (gateway operator sees the negotiated
# cipher ID). Forbidden symbols are flagged in *.rs files staged
# for commit; allow-list is inline (see check-aead.sh).
#
# Workspace-root invocation: scripts/scripts/check-aead.sh lives
# in the scripts repo; the hook runs from each consumer repo so
# we resolve the script via WS_ROOT (parent of the repo dir).
STAGED_RS_FOR_AEAD=$(git diff --cached --name-only --diff-filter=ACM \
    | grep '\.rs$' || true)
if [[ -n "$STAGED_RS_FOR_AEAD" ]]; then
    WS_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)/.."
    AEAD_SCRIPT="$WS_ROOT/scripts/scripts/check-aead.sh"
    if [[ -x "$AEAD_SCRIPT" ]]; then
        # Pass the staged files as individual paths so we don't
        # rescan the whole repo. check-aead.sh accepts directories
        # OR files (ripgrep handles both).
        AEAD_HITS=$(echo "$STAGED_RS_FOR_AEAD" \
            | xargs -r bash "$AEAD_SCRIPT" 2>&1 | grep -v '^ADR-046 OK' || true)
        if [[ -n "$AEAD_HITS" ]] \
            && echo "$AEAD_HITS" | grep -qE '(violation|hpke::Aead::Aes)'; then
            echo ""
            echo "$AEAD_HITS"
            exit 1
        fi
    fi
fi

# ============================================================
# 2. Check Rust formatting
# ============================================================
echo "[2/4] Checking Rust formatting..."

if command -v cargo &> /dev/null; then
    # Get staged Rust files
    STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

    if [[ -n "$STAGED_RS" ]]; then
        # Repos without any Cargo manifest (scripts: semgrep rule
        # fixtures are plain .rs files) can't run cargo fmt — check the
        # staged files with rustfmt directly instead of erroring out.
        if [ ! -f Cargo.toml ] && [ ! -d core ] && ! { [ -d wasm ] && [ -f wasm/Cargo.toml ]; }; then
            if command -v rustfmt &> /dev/null; then
                # shellcheck disable=SC2086
                if ! rustfmt --edition 2021 --check $STAGED_RS; then
                    echo ""
                    echo "ERROR: rustfmt check failed on staged .rs files."
                    echo "Run 'rustfmt --edition 2021 <file>' to fix."
                    exit 1
                fi
                echo "  Formatting OK (rustfmt, no Cargo manifest in repo)"
            fi
        # Check if cargo fmt is available
        elif cargo fmt --version &> /dev/null; then
            # Check formatting without making changes
            # Run fmt in the directory containing Cargo.toml (core/ for core workspace,
            # wasm/ for web-demo, or repo root for cli/tui/relay/e2e).
            # Subshell prevents cwd leaking to subsequent checks.
            FMT_DIR="."
            if [ -d core ]; then
                FMT_DIR="core"
            elif [ -d wasm ] && [ -f wasm/Cargo.toml ]; then
                FMT_DIR="wasm"
            fi
            if ! (cd "$FMT_DIR" && cargo fmt --all -- --check 2>/dev/null); then
                # On Windows, cargo fmt --all may fail with "filename too long"
                # (os error 206). Fall back to per-package checks for staged files.
                PACKAGES=$(echo "$STAGED_RS" | sed -n 's|^\(vauchi-[^/]*\)/.*|\1|p' | sort -u)
                if [[ -n "$PACKAGES" ]]; then
                    FMT_FAIL=0
                    for pkg in $PACKAGES; do
                        if ! (cd "$FMT_DIR" && cargo fmt -p "$pkg" -- --check 2>/dev/null); then
                            FMT_FAIL=1
                        fi
                    done
                    if [[ $FMT_FAIL -ne 0 ]]; then
                        echo ""
                        echo "ERROR: Rust formatting check failed."
                        echo "Run 'cargo fmt --all' to fix."
                        exit 1
                    fi
                else
                    echo ""
                    echo "ERROR: Rust formatting check failed."
                    echo "Run 'cargo fmt --all' to fix."
                    exit 1
                fi
            fi
            echo "  Formatting OK"
        else
            echo "  (cargo fmt not available, skipping)"
        fi
    else
        echo "  No Rust files staged, skipping"
    fi
else
    echo "  (cargo not found, skipping)"
fi

# ============================================================
# 2. Check test structure
# ============================================================
echo "[3/4] Checking test structure..."

# Only check staged Rust files in src/ directories. Vendored third-party
# crates (core/vendor/) are copied byte-identical from the cargo registry
# and keep upstream's inline #[cfg(test)] modules — they are not held to the
# project's production/test-separation rule (the byte-identical requirement
# forbids adding INLINE_TEST_REQUIRED markers to them).
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^.*src/.*\.rs$' | grep -Ev '(^|/)vendor/' || true)

if [[ -z "$STAGED_RS_FILES" ]]; then
    exit 0
fi

VIOLATIONS=0

for file in $STAGED_RS_FILES; do
    if [[ ! -f "$file" ]]; then
        continue
    fi

    # Check if file contains #[cfg(test)] without INLINE_TEST_REQUIRED marker
    if grep -q '#\[cfg(test)\]' "$file"; then
        if ! grep -B5 '#\[cfg(test)\]' "$file" | grep -q 'INLINE_TEST_REQUIRED:'; then
            echo "VIOLATION: $file"
            echo "  Found #[cfg(test)] without INLINE_TEST_REQUIRED marker"
            echo "  Either move tests to tests/ directory or add:"
            echo "    // INLINE_TEST_REQUIRED: <reason>"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    fi
done

if [[ $VIOLATIONS -gt 0 ]]; then
    echo ""
    echo "Commit blocked: $VIOLATIONS file(s) have inline tests without justification."
    echo "See CLAUDE.md: src/ = production only, tests/ = tests only"
    exit 1
fi

echo "  Test structure OK"

# ============================================================
# 3. Check for potential secrets
# ============================================================
echo "[4/4] Checking for potential secrets..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
SECRET_PATTERNS=(
    'PRIVATE[_-]?KEY'
    'SECRET[_-]?KEY'
    'API[_-]?KEY[[:space:]]*='
    'PASSWORD[[:space:]]*='
    'BEGIN RSA PRIVATE KEY'
    'BEGIN EC PRIVATE KEY'
    'BEGIN OPENSSH PRIVATE KEY'
    'aws_secret_access_key'
    'ghp_[a-zA-Z0-9]{36}'  # GitHub personal access token
)

SECRET_FOUND=0
for file in $STAGED_FILES; do
    if [[ ! -f "$file" ]]; then
        continue
    fi

    # Skip binary files and common false-positive files
    if file "$file" | grep -q 'binary\|image\|executable'; then
        continue
    fi

    # Skip test files and example configs
    if [[ "$file" =~ (test|spec|example|sample|mock) ]]; then
        continue
    fi

    for pattern in "${SECRET_PATTERNS[@]}"; do
        if grep -iEq "$pattern" "$file" 2>/dev/null; then
            echo "  WARNING: Potential secret in $file (pattern: $pattern)"
            SECRET_FOUND=1
        fi
    done
done

if [[ $SECRET_FOUND -eq 1 ]]; then
    echo ""
    echo "WARNING: Potential secrets detected in staged files."
    echo "Please review the files above and ensure no secrets are committed."
    echo "If these are false positives, you can bypass with: git commit --no-verify"
    # Don't exit 1 - just warn, as these might be false positives
fi

echo "  Secrets check OK"

# ============================================================
# 5. Shell portability checks (staged .sh and .just files)
# ============================================================
STAGED_SHELL=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|bash|just)$' || true)

if [[ -n "$STAGED_SHELL" ]]; then
    echo "[5/6] Checking shell portability..."

    # shellcheck (industry standard — catches echo -e, [[ ]] in sh, etc.)
    if command -v shellcheck &> /dev/null; then
        SC_FILES=$(echo "$STAGED_SHELL" | grep -E '\.(sh|bash)$' || true)
        SC_ERRORS=""
        for f in $SC_FILES; do
            [[ -f "$f" ]] || continue
            result=$(shellcheck -S warning "$f" 2>&1) || SC_ERRORS="${SC_ERRORS}${result}\n"
        done
        if [[ -n "$SC_ERRORS" ]]; then
            echo ""
            printf "%b" "$SC_ERRORS"
            echo ""
            echo "ERROR: shellcheck found issues in staged shell scripts."
            echo "Fix them or add inline directives: # shellcheck disable=SCXXXX"
            exit 1
        fi
    fi

    # Custom portable-shell linter (catches GNU-vs-BSD patterns shellcheck misses)
    # Resolve from the hook's own location (core.hooksPath), not the
    # committed repo's toplevel — toplevel-relative resolution only
    # worked for the workspace-root repo and silently skipped the
    # check for every sub-repo commit (including scripts itself).
    HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -x "$HOOK_DIR/check-portable-shell.sh" ]]; then
        # shellcheck disable=SC2086
        if ! "$HOOK_DIR/check-portable-shell.sh" $STAGED_SHELL; then
            exit 1
        fi
    fi
else
    echo "[5/6] No shell files staged, skipping"
fi

# ============================================================
# cargo-vet audits guard (VSC01)
# ============================================================
# [[audits]] entries are human attestations; AI-staged additions are
# blocked. Page: _private/docs/lint-errors/vsc01-no-ai-audits.md
if git diff --cached --name-only --diff-filter=ACM | grep -q 'supply-chain/audits\.toml$'; then
    VET_GUARD="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../scripts/check-vet-audits.sh"
    if [[ -x "$VET_GUARD" ]] && ! "$VET_GUARD"; then
        exit 1
    fi
fi

# ============================================================
# CI-yaml configuration lint (VCI02/03)
# ============================================================
# extends+before_script without !reference (VCI02, archive E23) and
# || true swallowing state-changing git in CI (VCI03, log L26).
# Pages: _private/docs/lint-errors/vci*.md
STAGED_CI_YML=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '(^|/)\.gitlab-ci\.yml$|(^|/)ci-templates/[^/]+\.ya?ml$|(^|/)\.gitlab/.+\.ya?ml$' || true)
if [[ -n "$STAGED_CI_YML" ]]; then
    CI_LINT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../scripts/check-ci-yaml-lint.sh"
    if [[ -x "$CI_LINT" ]]; then
        # shellcheck disable=SC2086
        if ! "$CI_LINT" $STAGED_CI_YML; then
            exit 1
        fi
    fi
fi

# ============================================================
# 6. Commit scope warning (non-blocking)
# ============================================================
# Warn when staged files span too many concern areas.
# Catches non-atomic commits (E10 pattern) without blocking.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR)
if [[ -n "$STAGED_ALL" ]]; then
    # Extract concern buckets: top-2 path components (e.g., "core/src", "just/", "docs/")
    BUCKETS=$(echo "$STAGED_ALL" | sed 's|/[^/]*$||' | sed 's|/.*||' | sort -u)
    BUCKET_COUNT=$(echo "$BUCKETS" | wc -l | tr -d ' ')
    FILE_COUNT=$(echo "$STAGED_ALL" | wc -l | tr -d ' ')

    if [[ "$BUCKET_COUNT" -gt 3 && "$FILE_COUNT" -gt 5 ]]; then
        echo ""
        echo "  NOTE: Broad commit — $FILE_COUNT files across $BUCKET_COUNT directories:"
        echo "$BUCKETS" | sed 's/^/    /'
        echo "  Consider splitting into atomic commits (one concern each)."
        echo "  Override: this is a warning, not a block."
    fi
fi

echo ""
echo "=== All pre-commit checks passed ==="
