{
  "boundary_rules": {
    "retired_screen_model": {
      "message": "ADR-066 retires ScreenModel from frontends and bindings; consume generic Command values.",
      "allow_exceptions": false,
      "patterns": [
        "\\bScreenModel\\b"
      ]
    },
    "retired_workflow_engine": {
      "message": "ADR-066 retires WorkflowEngine from frontends and bindings; Core owns workflows.",
      "allow_exceptions": false,
      "patterns": [
        "\\bWorkflowEngine\\b"
      ]
    },
    "retired_user_action": {
      "message": "ADR-066 retires UserAction from frontends and bindings; emit opaque Event values.",
      "allow_exceptions": false,
      "patterns": [
        "\\bUserAction\\b"
      ]
    },
    "retired_action_result": {
      "message": "ADR-066 retires ActionResult from frontends and bindings; consume generic Command values.",
      "allow_exceptions": false,
      "patterns": [
        "\\bActionResult\\b"
      ]
    },
    "retired_domain_components": {
      "message": "ADR-066 forbids domain-bearing component and visibility types in shells.",
      "allow_exceptions": false,
      "patterns": [
        "\\bComponent\\b",
        "\\bUiFieldVisibility\\b",
        "\\bVisibilityMode\\b",
        "\\bvisibility_label\\b",
        "\\bvisibilityLabel\\b"
      ]
    },
    "split_dispatch_api": {
      "message": "ADR-066 requires one Event input and Command[] output; retire action/result/screen dispatch APIs.",
      "allow_exceptions": false,
      "patterns": [
        "\\b(?:handleAction|handle_action|handleActionJson|handle_action_json)\\b",
        "\\b(?:handleHardwareEvent|handle_hardware_event)\\b",
        "\\b(?:currentScreen|current_screen|processActionResult|applyResult)\\b",
        "\\b(?:workflow_handle_action|app_handle_action|app_current_screen)\\b"
      ]
    }
  },
  "repos": {
    "core": {
      "source_roots": [
        "core/vauchi-platform/src",
        "core/vauchi-cabi/src"
      ],
      "extensions": [
        ".rs"
      ],
      "exclude_dirs": [
        "target",
        "tests"
      ],
      "rules": {}
    },
    "cli": {
      "source_roots": [
        "cli/src"
      ],
      "extensions": [
        ".rs"
      ],
      "exclude_dirs": [
        "target",
        "tests"
      ],
      "rules": {}
    },
    "ios": {
      "source_roots": [
        "ios/Vauchi"
      ],
      "extensions": [
        ".swift"
      ],
      "exclude_dirs": [
        "Generated",
        "uniffi",
        "Libs",
        "Vauchi.xcodeproj",
        "VauchiSnapshotTests",
        "VauchiUITests",
        "VauchiTests",
        "Preview Content",
        "build",
        ".spm-packages"
      ],
      "rules": {
        "action_id_minting": {
          "message": "Frontend must not mint action ids; core must supply explicit action_id.",
          "patterns": [
            "\"\\\\\\([^)]*\\):edit\"",
            "\"\\\\\\([^)]*\\):save\"",
            "\"confirm_\\$\\{[^}]*\\}\"",
            "\"cancel_\\$\\{[^}]*\\}\"",
            "\"edit_avatar\"",
            "\"filter_group:"
          ]
        },
        "error_substring_classification": {
          "message": "Core must return typed error codes; frontend must not classify errors by substring.",
          "patterns": [
            "\\.contains\\(\"lock screen\"",
            "\\.contains\\(\"device authentication\"",
            "\\.contains\\(\"wrong key\"",
            "\\.contains\\(\"corrupted\"",
            "hasPrefix\\(\"wb://\"\\)"
          ]
        },
        "domain_screen_id_branch": {
          "message": "screen_id must be opaque; do not branch on domain screen id literals.",
          "patterns": [
            "case\\s+\"(multi_stage_exchange|exchange_nfc_role|exchange_show_qr|contact_detail|contacts|my_info|group_detail|entry_detail|contact_edit)\"",
            "==\\s+\"(multi_stage_exchange|exchange_nfc_role|exchange_show_qr|contact_detail|contacts|my_info)\""
          ]
        },
        "notification_category_mapping": {
          "message": "NotificationCategory mapping to OS presentation belongs in core.",
          "patterns": [
            "\\bNotificationCategory\\b"
          ]
        },
        "field_visibility_interpretation": {
          "message": "Core must emit prepared copy, state, and tokens; frontend must not interpret domain strings.",
          "patterns": [
            "\\bfunc\\s+iconForFieldType",
            "\\bVisibilityMode\\b",
            "\\bvisibility_mode\\b"
          ]
        },
        "app_screen_enum_branch": {
          "message": "Frontend must not branch on domain screens; render generic Command values and emit opaque Event values.",
          "patterns": [
            "case\\s+AppScreen\\.",
            "[=!]=\\s*AppScreen\\."
          ]
        }
      }
    },
    "android": {
      "source_roots": [
        "android/app/src/main"
      ],
      "extensions": [
        ".kt",
        ".java"
      ],
      "exclude_dirs": [
        "uniffi",
        "build",
        "test",
        "androidTest"
      ],
      "rules": {
        "action_id_minting": {
