          "message": "Core must return typed error codes; frontend must not classify errors by substring.",
          "patterns": [
            "\\.Contains\\(\"lock screen\"",
            "\\.Contains\\(\"device authentication\""
          ]
        },
        "domain_screen_id_branch": {
          "message": "screen_id must be opaque; do not branch on domain screen id literals.",
          "patterns": [
            "\"(multi_stage_exchange|exchange_show_qr|contact_detail|contacts|my_info)\""
          ]
        },
        "app_screen_enum_branch": {
          "message": "Frontend must not branch on domain screens; render generic Command values and emit opaque Event values.",
          "patterns": [
