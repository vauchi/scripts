{
  "repos": {
    "ios": {
      "source_roots": [
        "ios/Vauchi"
      ],
      "extensions": [
        ".swift"
      ],
      "exclude_dirs": [
        "Generated",
        "uniffi",
        "Libs",
        "Vauchi.xcodeproj",
        "VauchiSnapshotTests",
        "VauchiUITests",
        "VauchiTests",
        "Preview Content",
        "build",
        ".spm-packages"
      ],
      "rules": {
        "action_id_minting": {
          "message": "Frontend must not mint action ids; core must supply explicit action_id.",
          "patterns": [
            "\"\\\\\\([^)]*\\):edit\"",
            "\"\\\\\\([^)]*\\):save\"",
            "\"confirm_\\$\\{[^}]*\\}\"",
            "\"cancel_\\$\\{[^}]*\\}\"",
            "\"edit_avatar\"",
            "\"filter_group:"
          ]
        },
        "error_substring_classification": {
          "message": "Core must return typed error codes; frontend must not classify errors by substring.",
          "patterns": [
            "\\.contains\\(\"lock screen\"",
            "\\.contains\\(\"device authentication\"",
            "\\.contains\\(\"wrong key\"",
            "\\.contains\\(\"corrupted\"",
            "hasPrefix\\(\"wb://\"\\)"
          ]
        },
        "domain_screen_id_branch": {
          "message": "screen_id must be opaque; do not branch on domain screen id literals.",
          "patterns": [
            "case\\s+\"(multi_stage_exchange|exchange_nfc_role|exchange_show_qr|contact_detail|contacts|my_info|group_detail|entry_detail|contact_edit)\"",
            "==\\s+\"(multi_stage_exchange|exchange_nfc_role|exchange_show_qr|contact_detail|contacts|my_info)\""
          ]
        },
        "notification_category_mapping": {
          "message": "NotificationCategory mapping to OS presentation belongs in core.",
          "patterns": [
            "\\bNotificationCategory\\b"
          ]
        },
        "field_visibility_interpretation": {
          "message": "Core must emit visibility_controls and icon_token; frontend must not interpret domain strings.",
          "patterns": [
            "\\bfunc\\s+iconForFieldType",
            "\\bVisibilityMode\\b",
            "\\bvisibility_mode\\b"
          ]
        }
      }
    },
    "android": {
      "source_roots": [
